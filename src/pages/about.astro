---
import Base from '../layouts/Base.astro';
import VersionSwitch from '../components/VersionSwitch.astro';
import content from '../content/about.json';
import site from '../content/site.json';
---
<Base title={content.meta.title} description={content.meta.description}>

<header id="hd">
  <div class="wrap nav">
    <a href="/" class="brand">Brynn<span>.</span></a>
    <nav class="nav-links" id="siteNav">
      <a href="index.html#work">{site.nav.work}</a>
      <a href="/about.html" class="active" aria-current="page">{site.nav.about}</a>
      <a href="mailto:brynn06191@gmail.com" class="nav-cta">{site.nav.contact}</a>
      <VersionSwitch here="classic" to="/about-motion.html" klass="nav-switch-m" label="MOTION ↗" />
    </nav>
    <div class="nav-right">
      <VersionSwitch here="classic" to="/about-motion.html" klass="nav-switch" label="MOTION ↗" />
      <button class="nav-toggle" id="navToggle" aria-label="開啟選單" aria-expanded="false" aria-controls="siteNav"><span></span><span></span></button>
    </div>
  </div>
</header>

<main>

  <!-- 01 About Hero -->
  <section class="ahero">
    <div class="wrap">
      <div class="ahero-grid">
        <div>
          <h1 class="display">
            <span class="reveal in" style="display:block;animation-delay:.1s"><Fragment set:html={content.hero.headingLine1} /></span>
            <span class="reveal in" style="display:block;animation-delay:.18s">{content.hero.headingLine2}</span>
          </h1>
          <div class="ahero-body reveal in" style="animation-delay:.28s">
            <p>{content.hero.intro}</p>
          </div>
        </div>
        <div class="ahero-side reveal in" style="animation-delay:.2s">
          <img class="ahero-photo" src={content.hero.profile.photo.src} alt={content.hero.profile.photo.alt} />
          <div class="ahero-meta">
            <strong>{content.hero.profile.name}</strong>
            <span>{content.hero.profile.role}</span>
            <span>{content.hero.profile.location}</span>
          </div>
          <div class="ahero-cta">
            <a class="btn" href={content.hero.profile.emailButton.href}>{content.hero.profile.emailButton.label}</a>
            <a class="btn ghost" href={content.hero.profile.resumeButton.href} download>{content.hero.profile.resumeButton.label}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 經歷與背景 -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head obs">
        <span class="num">{content.background.number}</span>
        <h2 class="display">{content.background.title}</h2>
      </div>
      <div class="facts-grid obs">
        <div class="fcol">
          <h3>{content.background.experience.heading}</h3>
          {content.background.experience.items.map((item) => (
            <div class="fitem">
              <h4>{item.title}</h4>
              <div class="meta">{item.meta}</div>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
        <div class="fcol">
          <h3>{content.background.education.heading}</h3>
          {content.background.education.items.map((item) => (
            <div class="fitem">
              <h4>{item.title}</h4>
              <div class="meta">{item.meta}</div>
            </div>
          ))}
          <h3 style="margin-top:34px">{content.background.tools.heading}</h3>
          {content.background.tools.items.map((item) => (
            <div class="fitem">
              <h4 style="font-size:15.5px">{item.title}</h4>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
        <div class="fcol">
          <h3>{content.background.recognition.heading}</h3>
          {content.background.recognition.items.map((item) => (
            <div class="fitem">
              <h4>{item.title}</h4>
              <p><a class="flink" href={item.linkHref}>{item.linkLabel}</a></p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 職涯路徑 -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head obs">
        <span class="num">{content.careerPath.number}</span>
        <h2 class="display">{content.careerPath.title}</h2>
      </div>
      <p class="sec-fore obs">{content.careerPath.lead}</p>
      <div class="cards3 obs">
        {content.careerPath.cards.map((card) => (
          <div class="card">
            <span class="k">{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 我實際負責什麼 -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head obs">
        <span class="num">{content.responsibilities.number}</span>
        <h2 class="display">{content.responsibilities.title}</h2>
      </div>
      <p class="sec-fore obs">{content.responsibilities.lead}</p>
      <div class="cards3 obs">
        {content.responsibilities.cards.map((card) => (
          <div class="card">
            <span class="k">{card.label}</span>
            <h3>{card.title}</h3>
            {card.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <div class="tags">{card.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
        ))}
      </div>
      <div class="ai-note obs">
        <span class="eyebrow">{content.responsibilities.aiNote.eyebrow}</span>
        <h4>{content.responsibilities.aiNote.title}</h4>
        {content.responsibilities.aiNote.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 我如何和團隊合作 -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head obs">
        <span class="num">{content.collaboration.number}</span>
        <h2 class="display">{content.collaboration.title}</h2>
      </div>
      <p class="sec-fore obs">{content.collaboration.lead}</p>
      <div class="collab obs">
        {content.collaboration.cards.map((card) => (
          <div class="card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 工作之外 -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head obs">
        <span class="num">{content.beyondWork.number}</span>
        <h2 class="display">{content.beyondWork.title}</h2>
      </div>
      <div class="aside-note obs">
        <p>{content.beyondWork.body}</p>
      </div>
    </div>
  </section>

  <!-- 07 Contact -->
  <section class="acontact">
    <div class="wrap">
      <h2 class="display obs" style="margin-top:14px">{content.contact.title}</h2>
      <p class="obs">{content.contact.lead}</p>
      <div class="ctas obs">
        <a class="btn" href={content.contact.workButton.href}>{content.contact.workButton.label}</a>
        <a class="btn ghost" href={content.contact.resumeButton.href} download>{content.contact.resumeButton.label}</a>
        <a class="btn ghost" href={content.contact.emailButton.href}>{content.contact.emailButton.label}</a>
      </div>
      <div class="mailrow obs">
        <a href={content.contact.email.href}>{content.contact.email.text}</a>
        <button class="copybtn" id="copymail" type="button" aria-label="複製 Email 地址">複製 Email</button>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap foot">
    <span>{site.footerAbout.left}</span>
    <span>{site.footerAbout.right}</span>
  </div>
</footer>

<script is:inline>
  // sticky nav background
  const hd = document.getElementById('hd');
  const onScroll = () => hd.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // mobile hamburger
  const tog = document.getElementById('navToggle');
  const links = document.getElementById('siteNav');
  if (tog && links) {
    const setOpen = (o) => {
      links.classList.toggle('open', o);
      tog.setAttribute('aria-expanded', o);
      tog.setAttribute('aria-label', o ? '關閉選單' : '開啟選單');
      hd.classList.toggle('menu-open', o);
    };
    tog.addEventListener('click', () => setOpen(!links.classList.contains('open')));
    links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });
  }


  // scroll reveal
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.obs').forEach((el) => io.observe(el));

  // email copy with feedback
  const cb = document.getElementById('copymail');
  cb.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('brynn06191@gmail.com');
      cb.textContent = '已複製 ✓';
      cb.classList.add('done');
      setTimeout(() => { cb.textContent = '複製 Email'; cb.classList.remove('done'); }, 2000);
    } catch (e) {
      cb.textContent = '請手動複製';
    }
  });
</script>


</Base>
<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  ::selection { background: var(--accent); color: var(--paper); }
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: var(--max); margin: 0 auto; padding: 0 32px; }
  .display {
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.015em;
  }
  .eyebrow {
    font-size: 12.5px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--ink-faint); font-weight: 600;
  }

  /* NAV（與首頁一致） */
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    transition: background .4s var(--ease), border-color .4s var(--ease), backdrop-filter .4s;
    border-bottom: 1px solid transparent;
  }
  header.scrolled {
    background: rgba(255,255,255,.94);
    border-bottom: 1px solid var(--line);
  }
  .nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 76px; }
  .nav-links { justify-self: center; }
  .nav-right { justify-self: end; display: flex; align-items: center; gap: 22px; }
  .nav-switch { font-size: 14.5px; color: var(--ink-soft); letter-spacing: .02em; position: relative; transition: color .3s; }
  .nav-switch::after { content: ""; position: absolute; left: 0; bottom: -5px; width: 0; height: 1.5px; background: var(--cyan); transition: width .35s var(--ease); }
  .nav-switch:hover { color: var(--ink); }
  .nav-switch:hover::after { width: 100%; }
  .nav-switch-m { display: none; }
  .brand { font-family: "Fraunces", serif; font-size: 21px; font-weight: 500; letter-spacing: -.01em; }
  .brand span { color: var(--accent); }
  .nav-links { display: flex; gap: 34px; align-items: center; }
  .nav-links a { font-size: 14.5px; color: var(--ink-soft); position: relative; transition: color .3s; }
  .nav-links a::after {
    content: ""; position: absolute; left: 0; bottom: -5px;
    width: 0; height: 1.5px; background: var(--cyan);
    transition: width .35s var(--ease);
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a:hover::after, .nav-links a:focus-visible::after { width: 100%; }
  .nav-links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .nav-links a.active { color: var(--ink); font-weight: 600; }
  .nav-links a.active::after { width: 100%; background: var(--clay); }
  .nav-cta {
    border: 1px solid var(--ink); border-radius: 100px;
    padding: 8px 18px !important; color: var(--ink) !important;
    transition: background .3s, color .3s;
  }
  .nav-cta::after { display: none; }
  .nav-cta:hover { background: var(--clay); border-color: var(--clay); color: var(--paper) !important; }

  /* 進場 */
  .reveal { opacity: 0; transform: translateY(26px); }
  .in { animation: rise .55s var(--ease) forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }
  .obs { opacity: 0; transform: translateY(34px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  .obs.show { opacity: 1; transform: none; }

  section { position: relative; z-index: 2; }
  .sec { padding: 120px 0 0; position: relative; }
  /* 背景幾何裝飾：低干擾方塊（奇偶區塊左右交錯） */
  .sec::before {
    content: ""; position: absolute; top: 96px; right: 38px;
    width: 58px; height: 58px; border: 1.5px solid var(--cyan);
    opacity: .38; z-index: -1; pointer-events: none;
  }
  .sec:nth-of-type(odd)::before { right: auto; left: 38px; top: 118px; }
  /* AI workflow 卡片左上角的方塊記號 */
  .ai-note { position: relative; }
  .ai-note::before {
    content: ""; position: absolute; top: -7px; left: -7px;
    width: 14px; height: 14px; background: var(--cyan); pointer-events: none;
  }
  /* 頁首左下角的實心小方塊 */
  .ahero::after {
    content: ""; position: absolute; bottom: 10px; left: 40px;
    width: 19px; height: 19px; background: var(--cyan);
    z-index: -1; pointer-events: none;
  }
  .sec-head { display: flex; align-items: baseline; gap: 18px; margin-bottom: 44px; }
  .sec-head .num { font-size: 13px; color: var(--clay); letter-spacing: .08em; white-space: nowrap; }
  .sec-head .num::before { content: "( "; }
  .sec-head .num::after { content: " )"; }
  .sec-head h2 { font-size: clamp(28px, 4vw, 44px); }
  .sec-head h2::after { content: ""; display: inline-block; width: 12px; height: 12px; margin-left: 14px; margin-bottom: 3px; background: var(--cyan); box-shadow: 8px -8px 0 -2.5px var(--paper), 8px -8px 0 -1px var(--cyan); }
  .sec-fore { color: var(--ink-soft); margin-bottom: 44px; }

  /* 01 Hero */
  .ahero { padding: 170px 0 0; position: relative; }
  .ahero::before { content: ""; position: absolute; top: 106px; right: 44px; width: 15px; height: 15px; background: var(--cyan); box-shadow: 11px -11px 0 -3px var(--paper), 11px -11px 0 -1px var(--cyan); }
  .ahero-grid { display: grid; grid-template-columns: 7fr 5fr; gap: 72px; align-items: start; }
  .ahero .eyebrow { display: block; margin-bottom: 22px; }
  .ahero h1 { font-size: clamp(40px, 5.6vw, 76px); }
  .ahero h1 span { white-space: nowrap; }
  .ahero h1 > span:last-child::after { content: ""; display: inline-block; width: 13px; height: 13px; margin-left: 16px; background: var(--cyan); box-shadow: 9px -9px 0 -2.5px var(--paper), 9px -9px 0 -1px var(--cyan); }
  .ahero-body { margin-top: 30px; color: var(--ink-soft); max-width: 36em; }
  .ahero-body p + p { margin-top: 16px; }
  .ahero-side { padding-top: 6px; }
  .ahero-photo {
    width: 100%; max-width: 300px; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 2px; display: block; border: 1px solid var(--line);
  }
  .ahero-meta { margin-top: 20px; line-height: 1.9; }
  .ahero-meta strong { display: block; font-size: 16px; }
  .ahero-meta span { display: block; font-size: 14px; color: var(--ink-faint); }
  .ahero-cta { margin-top: 18px; display: flex; gap: 14px; flex-wrap: wrap; }
  .btn {
    display: inline-block; font-size: 14.5px;
    border: 1px solid var(--ink); border-radius: 0; padding: 9px 20px;
    transition: background .3s, color .3s;
  }
  .btn:hover, .btn:focus-visible { background: var(--ink); color: var(--paper); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .btn.ghost { border-color: var(--line); color: var(--ink-soft); }
  .btn.ghost:hover, .btn.ghost:focus-visible { border-color: var(--ink); background: var(--ink); color: var(--paper); }

  /* 02 職涯路徑 / 03 負責範圍 */
  .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--line); border: 1px solid var(--line); }
  .card { background: var(--paper); padding: 36px 30px; transition: background .4s; }
  .card:hover { background: var(--paper-2); }
  .card .k { color: var(--clay); font-size: 12.5px; letter-spacing: .08em; }
  .card .k::before { content: "( "; }
  .card .k::after { content: " )"; }
  .card h3 { font-family: "Fraunces", serif; font-weight: 500; font-size: 21px; margin: 12px 0 12px; }
  .card p { font-size: 15px; color: var(--ink-soft); }
  .card p + p { margin-top: 10px; }
  .card .tags { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  .card .tags span {
    font-size: 12px; color: var(--ink-soft);
    border: 1px solid var(--line); border-radius: 0; padding: 3px 11px;
  }
  .path-arrow { text-align: center; color: var(--ink-faint); font-size: 13px; margin-top: 14px; }

  /* AI 補充帶 */
  .ai-note { border: 1px solid var(--line); border-top: 0; background: var(--paper); padding: 32px 30px; }
  .ai-note .eyebrow { display: block; margin-bottom: 10px; }
  .ai-note h4 { font-family: "Fraunces", serif; font-weight: 500; font-size: 20px; margin-bottom: 12px; }
  .ai-note p { font-size: 15px; color: var(--ink-soft); }
  .ai-note p + p { margin-top: 12px; }

  /* 04 團隊合作 */
  .collab { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--line); border: 1px solid var(--line); }
  .collab .card h3 { font-size: 19px; }

  /* 05 經歷與背景 */
  .facts-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 56px; }
  .fcol h3 { font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); font-weight: 600; border-top: 2px solid var(--ink); padding-top: 16px; margin-bottom: 18px; }
  .fitem { padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid var(--line); }
  .fitem:last-child { border-bottom: 0; }
  .fitem h4 { font-family: "Fraunces", serif; font-weight: 500; font-size: 18px; }
  .fitem .meta { font-size: 13.5px; color: var(--ink-faint); margin: 3px 0 8px; }
  .fitem p { font-size: 14.5px; color: var(--ink-soft); }
  .flink { border-bottom: 1px solid var(--line); padding-bottom: 1px; transition: color .3s, border-color .3s; }
  .flink:hover, .flink:focus-visible { color: var(--clay); border-color: var(--clay); }
  .cv-cta { margin-top: 40px; }

  /* 06 工作之外 */
  .aside-note { max-width: 36em; }
  .aside-note p { font-size: 15px; color: var(--ink-soft); }

  /* 07 Contact — inverted dark block, flows into footer */
  .acontact { padding: 150px 0 100px; margin-top: 130px; text-align: center; background: var(--dark); color: var(--dark-ink); }
  .acontact h2 { font-size: clamp(30px, 5vw, 56px); margin-bottom: 14px; }
  .acontact p { color: var(--dark-soft); margin-bottom: 30px; }
  .acontact .ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .acontact .btn { border-color: var(--dark-ink); color: var(--dark-ink); }
  .acontact .btn:hover, .acontact .btn:focus-visible { background: var(--dark-ink); color: var(--dark); }
  .acontact .btn.ghost { border-color: var(--dark-line); color: var(--dark-soft); }
  .acontact .btn.ghost:hover, .acontact .btn.ghost:focus-visible { border-color: var(--dark-ink); background: var(--dark-ink); color: var(--dark); }
  .mailrow { margin-top: 30px; display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .mailrow a { font-family: "Fraunces", serif; font-style: italic; font-size: 20px; color: var(--dark-ink); border-bottom: 1.5px solid var(--dark-soft); transition: border-color .3s; }
  .mailrow a:hover, .mailrow a:focus-visible { border-color: var(--dark-ink); }
  .copybtn {
    font-size: 13px; color: var(--dark-soft); background: none;
    border: 1px solid var(--dark-line); border-radius: 0; padding: 6px 14px;
    cursor: pointer; font-family: inherit; transition: border-color .3s, color .3s;
  }
  .copybtn:hover, .copybtn:focus-visible { border-color: var(--dark-ink); color: var(--dark-ink); }
  .copybtn.done { border-color: var(--clay); color: var(--clay); }

  footer { background: var(--dark); color: var(--dark-ink); padding: 40px 0 26px; }
  .foot {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 13.5px; color: var(--dark-soft); flex-wrap: wrap; gap: 12px;
    border-top: 1px solid var(--dark-line); padding-top: 18px;
  }

  .nav-toggle {
    display: none; background: none; border: 0; cursor: pointer;
    width: 44px; height: 44px; padding: 0; position: relative; z-index: 60;
  }
  .nav-toggle span {
    display: block; width: 22px; height: 1.5px; background: var(--ink);
    margin: 5px auto; transition: transform .3s var(--ease), opacity .3s;
  }
  .nav-toggle[aria-expanded="true"] span:first-child { transform: translateY(3.2px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.3px) rotate(-45deg); }
  header.menu-open {
    background: rgba(255,255,255,.97);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .nav { display: flex; justify-content: space-between; }
    .nav-right .nav-switch { display: none; }
    .nav-switch-m { display: block; }
    .nav-toggle { display: block; }
    .nav-links {
      display: flex; position: fixed; top: 76px; left: 0; right: 0;
      flex-direction: column; gap: 0; padding: 6px 22px 20px;
      background: rgba(255,255,255,.98);
      border-bottom: 1px solid var(--line);
      opacity: 0; transform: translateY(-8px); visibility: hidden; pointer-events: none;
