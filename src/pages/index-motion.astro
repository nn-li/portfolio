---
// 首頁 eric-cole 風預覽（index-motion）— 忠實版。
// 系統：大寫 Helvetica 大標｜等寬 mono 小標籤｜Inspiration 草寫斜體點綴｜
//       暖白 #f1f1ef／墨 #242424／燒橙 #d66d38｜掃描線紋理｜nav 置中 grid + 底線擦出。
// HERO 保留原本（先不動）。原 index.astro 不動。
import Base from '../layouts/Base.astro';
import VersionSwitch from '../components/VersionSwitch.astro';
import content from '../content/index.json';
import site from '../content/site.json';

const introLine = 'UI/UX DESIGNER — TURNING RESEARCH AND MESSY REQUIREMENTS INTO CLEAR, BUILDABLE PRODUCT EXPERIENCES.';
const claimLine = 'I CARE ABOUT PRODUCTS THAT ARE CLEAR TO UNDERSTAND, HONEST ABOUT TRADE-OFFS, AND EASY TO USE.';
// CAPABILITIES 各能力的一句說明（草稿，可再改）
const capsDesc = [
  '透過訪談、觀察與競品分析，把使用者的真實需求與痛點整理成設計依據。',
  '規劃內容結構與導覽邏輯，讓資訊好找、關係清楚。',
  '梳理任務流程與決策點，讓每一步都清楚、結果可預期。',
  '用可操作的原型及早驗證想法，發現問題再修正。',
  '設計清楚一致的介面與元件，兼顧美感與可用性。',
  '邀請真實使用者操作，依實際卡點迭代設計。',
];
---
<Base title={content.meta.title} description={content.meta.description}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

<!-- 開場載入 000% → 100% -->
<div class="loader" id="loader" aria-hidden="true">
  <canvas id="loaderCanvas"></canvas>
  <span class="loader-name">BRYNN</span>
  <span class="loader-count" id="loaderCount">000%</span>
</div>

<!-- NAV：置中 grid + mix-blend 反白 -->
<header id="hd" class="ec-header">
  <a href="#top" class="ec-logo">BRYNN</a>
  <nav class="ec-nav" id="siteNav" aria-label="Primary navigation">
    <a href="#work">+ WORK</a>
    <a href="/about-motion.html">+ ABOUT</a>
    <a href="#contact">+ CONTACT</a>
  </nav>
  <VersionSwitch here="motion" to="/" klass="ec-contact" label="CLASSIC ↗" />
  <button class="ec-menu" id="navToggle" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="siteNav"><span></span><span></span></button>
</header>

<main id="top">

  <!-- HERO（保留原本，未更動） -->
  <section class="hero">
    <img class="hero-cover" src="/assets/images/cover.svg?v=2" alt="" aria-hidden="true" />
    <div class="wrap">
      <div class="status reveal in" style="animation-delay:.05s">
        <span class="dot"></span> {content.hero.status}
      </div>
      <h1 class="display hero-title" id="heroTitle"><Fragment set:html={content.hero.headingHtml} /></h1>
      <div class="hero-photo reveal in" style="animation-delay:.2s" id="heroCard" tabindex="0" role="button" aria-label="翻轉卡片">
        <div class="flip-inner">
          <div class="flip-front">
            <img src={content.hero.portrait.src} alt={content.hero.portrait.alt} />
          </div>
          <div class="flip-back" aria-hidden="true">
            <span class="fb-hi"><Fragment set:html={content.hero.flipBackHtml} /></span>
            <span class="fb-line">↓</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO band -->
  <section class="ec-sec intro-band">
    <div class="ec-wrap">
      <p class="intro-scramble scramble" data-final={introLine}>{introLine}</p>
      <p class="code-note">◼ BASED IN TAIPEI // UI · UX · RESEARCH</p>
    </div>
  </section>

  <!-- WORK -->
  <section class="ec-sec ec-work" id="work">
    <div class="ec-wrap">
      <div class="work-top">
        <div class="work-lead">
          <img class="work-bg" src="/assets/bg/bg-material-1.svg" alt="" aria-hidden="true" />
          <p class="work-kicker">A FEW SELECTED<br />PROJECTS.</p>
        </div>
        <h2 class="section-title work-title">SELECTED<br />WORK</h2>
      </div>

      <div class="view-tabs" role="tablist" aria-label="作品顯示方式">
        <button type="button" class="active" data-mode="column">[COLUMN]</button>
        <button type="button" data-mode="list">[LIST]</button>
      </div>

      <div class="work-grid" id="workGrid">
        <div class="project-list">
          {content.work.projects.map((project, i) => (
            <a class={`plink ${i === 0 ? 'active' : ''}`} href={project.href} data-i={i}
               data-img={project.cover.src} data-name={project.title} data-meta={project.year}>
              <span class="pl-num">{String(i + 1).padStart(3, '0')}</span>
              <div class="pl-main">
                <span class="pl-name">{project.title}</span>
                <p class="pl-desc">{project.description}</p>
                <div class="pl-tags">{project.tags.map((t) => <span class={t.win ? 'win' : null}>{t.label}</span>)}</div>
              </div>
              <img class="pl-cover" src={project.cover.src} alt={project.cover.alt} loading="lazy" />
              <div class="pl-end"><span class="pl-year">{project.year}</span><span class="pl-arrow">↗</span></div>
              <span class="pl-live">VIEW LIVE ↗</span>
            </a>
          ))}
        </div>
        <figure class="project-preview" id="projectPreview">
          <img src={content.work.projects[0].cover.src} alt="" id="previewImg" />
          <figcaption>
            <span id="previewName">{content.work.projects[0].title}</span>
            <span id="previewMeta">{content.work.projects[0].year}</span>
          </figcaption>
        </figure>
      </div>

      <div class="available">
        <p>AVAILABLE FOR WORK</p>
        <a href={`mailto:${content.contact.email}`}>{content.contact.email} ↗</a>
      </div>
    </div>
  </section>

  <!-- APPROACH（= How I Work）：左標題（固定）+ 右直排卡片 -->
  <section class="ec-sec ec-approach" id="approach">
    <div class="ec-wrap approach-layout">
      <div class="approach-left"><h2 class="section-title">HOW I&nbsp;WORK</h2></div>
      <div class="approach-right">
        <div class="note-stack">
          {content.howIWork.cards.map((card, i) => (
            <article class="note-card">
              <span class="nc-num">{String(i + 1).padStart(3, '0')}</span>
              <h3 class="scramble" data-final={card.title}>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </div>
        <p class="approach-claim reveal">{claimLine}</p>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES（純黑，= 技能） -->
  <section class="ec-caps dark-section" id="caps">
    <div class="ec-wrap">
      <h2 class="section-title">CAPABILITIES <span class="st-tag">[WHAT I DO]</span></h2>
      <p class="caps-statement reveal">我從研究與流程規劃切入，把發現轉化為資訊架構、User Flow、Prototype 與介面規格。</p>
      <div class="cap-table reveal">
        {content.marquee.items.map((item, i) => (
          <article>
            <span class="ct-num">{String(i + 1).padStart(3, '0')}</span>
            <h3>{item}</h3>
            <p class="ct-desc">{capsDesc[i]}</p>
          </article>
        ))}
      </div>
      <div class="caps-cta reveal">
        <p>有專案想聊聊嗎？</p>
        <a href="#contact">LET&apos;S CHAT ↗</a>
      </div>
    </div>
  </section>

  <!-- ABOUT（首頁預告：兩欄，完整介紹在 /about.html） -->
  <section class="ec-sec ec-about" id="about">
    <div class="ec-wrap">
      <h2 class="section-title about-title">ABOUT</h2>
      <div class="about-grid reveal">
        <p class="about-lead"><Fragment set:html={content.about.leadHtml} /></p>
        <aside class="about-side">
          <p class="about-body">{content.about.body}</p>
          <a class="about-more" href="/about-motion.html">{content.about.moreLabel}</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- CONTACT（深色，Email + 連結） -->
  <section class="ec-contact-sec dark-section" id="contact">
    <div class="ec-wrap">
      <p class="kicker reveal">[LET&apos;S TALK]</p>
      <h2 class="contact-title">CONTACT<br />ME</h2>
      <a class="contact-mail" href={`mailto:${content.contact.email}`}>{content.contact.email} ↗</a>
      <div class="contact-links reveal">
        <a href="#work">+ {content.contact.workLinkLabel}</a>
        <a href="/assets/files/brynn-cv.pdf" download>+ {content.contact.cvLinkLabel}</a>
      </div>
    </div>
  </section>

</main>

<footer class="ec-footer dark-section">
  <div class="ec-wrap ec-foot">
    <p>{site.footerIndex.left}</p>
    <p>©2025</p>
  </div>
</footer>

<canvas id="cursorCanvas" aria-hidden="true"></canvas>

<script is:inline>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  (function () {
    const loader = document.getElementById('loader');
    const countEl = document.getElementById('loaderCount');
    if (!loader) return;
    if (reduceMotion) { loader.remove(); return; }
    let n = 0;
    const iv = setInterval(() => {
      n = Math.min(100, n + Math.ceil(Math.random() * 11));
      countEl.textContent = String(n).padStart(3, '0') + '%';
      if (n >= 100) clearInterval(iv);
    }, 45);
    setTimeout(() => { countEl.textContent = '100%'; loader.classList.add('done'); setTimeout(() => loader.remove(), 620); }, 1300);
  })();

  // 開場載入的蠟筆互動（把 footer 那種效果放到 onboarding）
  (function () {
    const lc = document.getElementById('loaderCanvas');
    if (!lc || reduceMotion) return;
    const ctx = lc.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => { lc.width = innerWidth * dpr; lc.height = innerHeight * dpr; lc.style.width = innerWidth + 'px'; lc.style.height = innerHeight + 'px'; };
    resize(); window.addEventListener('resize', resize);
    ctx.lineCap = 'round';
    let last = null;
    window.addEventListener('pointermove', (e) => {
      if (!document.getElementById('loader')) return;
      const x = e.clientX * dpr, y = e.clientY * dpr;
      if (last) {
        const dx = x - last.x, dy = y - last.y, dist = Math.hypot(dx, dy) || 1;
        const steps = Math.max(1, Math.floor(dist / (3 * dpr)));
        for (let s = 0; s <= steps; s++) {
          const t = s / steps, px = last.x + dx * t, py = last.y + dy * t;
          for (let k = 0; k < 5; k++) {
            const jx = (Math.random() - 0.5) * 10 * dpr, jy = (Math.random() - 0.5) * 10 * dpr, a = Math.random() * Math.PI, len = (2 + Math.random() * 5) * dpr;
            ctx.globalAlpha = 0.05 + Math.random() * 0.16; ctx.strokeStyle = 'rgb(23,232,255)'; ctx.lineWidth = (1 + Math.random() * 2.2) * dpr;
            ctx.beginPath(); ctx.moveTo(px + jx - Math.cos(a) * len, py + jy - Math.sin(a) * len); ctx.lineTo(px + jx + Math.cos(a) * len, py + jy + Math.sin(a) * len); ctx.stroke();
          }
        }
        ctx.globalAlpha = 1;
      }
      last = { x, y };
    }, { passive: true });
  })();

  (function () {
    const els = document.querySelectorAll('.clock');
    if (!els.length) return;
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Taipei' });
    const tick = () => { const t = fmt.format(new Date()); els.forEach((e) => (e.textContent = t)); };
    tick(); setInterval(tick, 30000);
  })();

  const hd = document.getElementById('hd');
  const onScroll = () => hd.classList.toggle('scrolled', window.scrollY > 40);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

  const tog = document.getElementById('navToggle');
  const navEl = document.getElementById('siteNav');
  if (tog && navEl) {
    const setOpen = (o) => { hd.classList.toggle('menu-open', o); tog.setAttribute('aria-expanded', o); };
    tog.addEventListener('click', () => setOpen(!hd.classList.contains('menu-open')));
    navEl.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }

  // nav 文字 hover 亂碼解析（借自 eric-cole）
  if (!reduceMotion) {
    const NCH = '@#%&+*<>=/';
    const navScramble = (el) => {
      const base = el.dataset.final || el.textContent;
      el.dataset.final = base;
      let f = 0; const tot = 34;
      const tk = () => {
        const p = Math.max(0, f / tot - 0.18);   // 先維持一段亂碼再慢慢解析
        el.textContent = base.split('').map((c, i) => (c === ' ' || c === '+') ? c : (i / base.length < p ? c : NCH[Math.floor(Math.random() * NCH.length)])).join('');
        f++;
        if (f <= tot) requestAnimationFrame(tk); else el.textContent = base;
      };
      tk();
    };
    document.querySelectorAll('.ec-nav a, .ec-contact').forEach((a) => a.addEventListener('mouseenter', () => navScramble(a)));
  }

  const card = document.getElementById('heroCard');
  if (card) {
    card.addEventListener('click', () => card.classList.toggle('flipped'));
    card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.classList.toggle('flipped'); } });
  }

  const splitChars = (el) => {
    let i = 0;
    const walk = (node) => {
      [...node.childNodes].forEach((child) => {
        if (child.nodeType === 3) {
          const frag = document.createDocumentFragment();
          for (const ch of child.textContent) {
            if (ch === ' ') { frag.appendChild(document.createTextNode(' ')); continue; }
            const mask = document.createElement('span'); mask.className = 'char-mask';
            const inner = document.createElement('span'); inner.className = 'char';
            inner.style.setProperty('--i', i++); inner.textContent = ch;
            mask.appendChild(inner); frag.appendChild(mask);
          }
          child.replaceWith(frag);
        } else if (child.nodeType === 1) { walk(child); }
      });
    };
    walk(el); el.classList.add('split');
  };
  if (!reduceMotion) {
    const heroTitle = document.getElementById('heroTitle');
    if (heroTitle) { splitChars(heroTitle); heroTitle.classList.add('play'); }
  }

  (function () {
    if (reduceMotion) return;
    const CH = '!<>-_\\/[]{}=+*^?#________';
    const run = (el) => {
      const final = el.getAttribute('data-final') || el.textContent;
      let frame = 0; const total = 48;
      const tick = () => {
        const p = frame / total;
        el.textContent = final.split('').map((c, i) => {
          if (c === ' ') return ' ';
          if (i / final.length < p) return c;
          return CH[Math.floor(Math.random() * CH.length)];
        }).join('');
        frame++;
        if (frame <= total) requestAnimationFrame(tick); else el.textContent = final;
      };
      tick();
    };
    const io = new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } }); }, { threshold: 0.4 });
    document.querySelectorAll('.scramble').forEach((el) => io.observe(el));
  })();

  (function () {
    const grid = document.getElementById('workGrid');
    if (!grid) return;
    const img = document.getElementById('previewImg');
    const nameEl = document.getElementById('previewName');
    const metaEl = document.getElementById('previewMeta');
    const links = grid.querySelectorAll('.plink');
    const setActive = (el) => {
      links.forEach((l) => l.classList.remove('active'));
      el.classList.add('active');
      img.src = el.getAttribute('data-img');
      img.style.animation = 'none'; void img.offsetWidth; img.style.animation = '';
      nameEl.textContent = el.getAttribute('data-name');
      metaEl.textContent = el.getAttribute('data-meta');
    };
    links.forEach((l) => { l.addEventListener('mouseenter', () => setActive(l)); l.addEventListener('focus', () => setActive(l)); });
    const work = document.getElementById('work');
    document.querySelectorAll('.view-tabs button').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.view-tabs button').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        work.classList.toggle('is-list', b.getAttribute('data-mode') === 'list');
      });
    });
  })();

  const io = new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); } }); }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal, .obs').forEach((el) => io.observe(el));

  // section 標題打字機效果（進場逐字打出，帶游標）
  if (!reduceMotion) {
    const titleEls = [...document.querySelectorAll('.section-title, .contact-title')];
    const prep = titleEls.map((el) => {
      const units = [];
      el.childNodes.forEach((ch) => {
        if (ch.nodeType === 3) { for (const c of ch.textContent) units.push({ t: 'char', v: c }); }
        else if (ch.nodeName === 'BR') units.push({ t: 'br' });
        else if (ch.nodeType === 1) units.push({ t: 'html', v: ch.outerHTML });
      });
      el.innerHTML = '';
      return { el, units, token: 0 };
    });
    const typeOne = (rec) => {
      const token = ++rec.token;
      rec.el.innerHTML = '';
      const caret = document.createElement('span'); caret.className = 'tw-caret';
      rec.el.appendChild(caret);
      let i = 0;
      const step = () => {
        if (token !== rec.token) return;   // 被新一輪取代
        if (i >= rec.units.length) { setTimeout(() => { if (token === rec.token) caret.remove(); }, 700); return; }
        const u = rec.units[i++];
        if (u.t === 'char') { const s = document.createElement('span'); s.textContent = u.v; rec.el.insertBefore(s, caret); }
        else if (u.t === 'br') rec.el.insertBefore(document.createElement('br'), caret);
        else { const tp = document.createElement('template'); tp.innerHTML = u.v; rec.el.insertBefore(tp.content, caret); }
        setTimeout(step, u.t === 'char' ? 48 : 14);
      };
      step();
    };
    // 每次滑進畫面就重播（不 unobserve）
    const tio = new IntersectionObserver((es) => es.forEach((e) => { const r = prep.find((p) => p.el === e.target); if (r && e.isIntersecting) typeOne(r); }), { threshold: 0.55 });
    prep.forEach((r) => tio.observe(r.el));
  }


  // HOW I WORK 卡片：下滑時往上推移（scroll parallax，平滑）
  if (!reduceMotion) {
    const cards = [...document.querySelectorAll('.note-card')];
    if (cards.length) {
      const cs = cards.map(() => ({ cur: 0, target: 0 }));
      const compC = () => {
        const vh = innerHeight;
        cards.forEach((c, i) => {
          const r = c.getBoundingClientRect();
          cs[i].target = ((r.top - vh / 2) / vh) * -52;
        });
      };
      const rafC = () => {
        cards.forEach((c, i) => { cs[i].cur += (cs[i].target - cs[i].cur) * 0.07; c.style.transform = 'translateY(' + cs[i].cur.toFixed(2) + 'px)'; });
        requestAnimationFrame(rafC);
      };
      compC(); rafC();
      window.addEventListener('scroll', compC, { passive: true });
      window.addEventListener('resize', compC, { passive: true });
    }
  }

  // 蠟筆游標軌跡（canvas）— 青/藍筆觸，跟 hero 背景同調，移動留痕、慢慢淡去
  const cvs = document.getElementById('cursorCanvas');
  if (cvs && !reduceMotion && matchMedia('(hover: hover)').matches) {
    const ctx = cvs.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0, H = 0;
    const resize = () => { W = cvs.width = innerWidth * dpr; H = cvs.height = innerHeight * dpr; cvs.style.width = innerWidth + 'px'; cvs.style.height = innerHeight + 'px'; };
    resize(); window.addEventListener('resize', resize);
    ctx.lineCap = 'round';
    let last = null;
    window.addEventListener('pointermove', (e) => {
      const x = e.clientX * dpr, y = e.clientY * dpr;
      if (last) {
        const dx = x - last.x, dy = y - last.y;
        const dist = Math.hypot(dx, dy) || 1;
        const steps = Math.max(1, Math.floor(dist / (3 * dpr)));
        for (let s = 0; s <= steps; s++) {
          const t = s / steps;
          const px = last.x + dx * t, py = last.y + dy * t;
          // 蠟筆顆粒：沿路徑疊多筆短的、隨機透明度/角度的小筆觸
          for (let k = 0; k < 5; k++) {
            const jx = (Math.random() - 0.5) * 10 * dpr;
            const jy = (Math.random() - 0.5) * 10 * dpr;
            const a = Math.random() * Math.PI;
            const len = (2 + Math.random() * 5) * dpr;
            ctx.globalAlpha = 0.05 + Math.random() * 0.16;
            ctx.strokeStyle = 'rgb(23,232,255)';
            ctx.lineWidth = (1 + Math.random() * 2.2) * dpr;
            ctx.beginPath();
            ctx.moveTo(px + jx - Math.cos(a) * len, py + jy - Math.sin(a) * len);
            ctx.lineTo(px + jx + Math.cos(a) * len, py + jy + Math.sin(a) * len);
            ctx.stroke();
          }
        }
        ctx.globalAlpha = 1;
      }
      last = { x, y };
    }, { passive: true });
    const fade = () => { ctx.globalCompositeOperation = 'destination-out'; ctx.fillStyle = 'rgba(0,0,0,.04)'; ctx.fillRect(0, 0, W, H); ctx.globalCompositeOperation = 'source-over'; requestAnimationFrame(fade); };
    fade();
  }
</script>

</Base>

<style is:global>
  :root {
    --ec-paper: #ffffff; --ec-paper-soft: #f4f4f4;
    --ec-ink: #141414; --ec-muted: #8a8a8a; --ec-line: rgba(20,20,20,.14);
    --ec-dark: #161616; --ec-dark-soft: #1e1e1e; --ec-dark-line: rgba(255,255,255,.22);
    --ec-accent: #0900ff; --ec-cyan: #17e8ff;
    --display: "Fraunces", Georgia, serif;
    --title: "Space Grotesk", "Hanken Grotesk", sans-serif;
    --mono: "Hanken Grotesk", system-ui, sans-serif;
    --helv: "Hanken Grotesk", system-ui, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
