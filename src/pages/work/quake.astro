<script is:inline>
  // 左側章節錨點：捲動高亮
  const links = [...document.querySelectorAll('.cx-nav a')];
  const map = {}; links.forEach(a => map[a.getAttribute('href')] = a);
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const a = map['#' + e.target.id];
        if (a) a.classList.add('active');
      }
    });
  }, { rootMargin: '-25% 0px -65% 0px' });
  document.querySelectorAll('[data-sec]').forEach(s => io.observe(s));

  // 互動 clip：滑到才播、離開就停（省效能）
  const cio = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      const v = e.target;
      if (e.isIntersecting) { v.play().catch(() => {}); }
      else { v.pause(); }
    });
  }, { threshold: 0.35 });
  document.querySelectorAll('.uclipv').forEach(v => cio.observe(v));
</script>

