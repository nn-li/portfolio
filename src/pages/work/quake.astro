---
import Base from '../../layouts/Base.astro';
import content from '../../content/work/quake.json';
import site from '../../content/site.json';
---
<Base title={content.title} description={content.description}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/case.css" /></Fragment>

<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">Brynn<span>.</span></a>
    <a class="back" href="/#work">{site.topbar.back}</a>
  </div>
</div>

<main>
  <!-- 滿版 hero -->
  <div class="cx-herobanner">
    <img src={content.hero.cover.src} alt={content.hero.cover.alt} />
  </div>

  <!-- 標題 -->
  <div class="cx-title">
    <span class="eyebrow">{content.hero.eyebrow}</span>
    <h1 class="display">{content.hero.title}</h1>
    <p class="lead">{content.hero.lead}</p>
    <div class="awards">
      <img class="award-img" src={content.hero.awardImage.src} alt={content.hero.awardImage.alt} />
      {content.hero.awards.map((a) => (
        <span class="award">{a.name} <span class="en">{a.en}</span></span>
      ))}
    </div>
  </div>

  <!-- meta -->
  <dl class="cx-metarow">
    {content.hero.meta.map((m) => (
      <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
    ))}
  </dl>

  <!-- 左導覽 + 敘事 -->
  <div class="cx">
    <aside class="cx-nav">
      <ul>
        <li><a href="#s1" class="active">{content.ch01.label}</a></li>
        <li><a href="#s2">{content.ch02.label}</a></li>
        <li><a href="#s3">{content.ch03.label}</a></li>
        <li><a href="#s4">{content.ch04.label}</a></li>
      </ul>
    </aside>

    <div class="cx-main">

      <!-- 01 背景與目標 -->
      <section class="cx-sec" id="s1" data-sec>
        <span class="secnum">{content.ch01.num}</span>
        <h2 class="lbl">{content.ch01.label}</h2>
        <p class="intro">{content.ch01.intro}</p>
        <div class="sub">
          <h3>{content.ch01.goals.title}</h3>
          <ul class="facts">
            {content.ch01.goals.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="sub">
          <h3>{content.ch01.problem.title}</h3>
          <p><Fragment set:html={content.ch01.problem.bodyHtml} /></p>
          <div class="fig"><img src={content.ch01.problem.figure.src} alt={content.ch01.problem.figure.alt} loading="lazy" /><div class="cap">{content.ch01.problem.figure.caption}</div></div>
        </div>
        <div class="sub">
          <h3>{content.ch01.research.title}</h3>
          <p>{content.ch01.research.body}</p>
          <div class="phases" style="grid-template-columns:1fr 1fr">
            {content.ch01.research.methods.map((m) => (
              <div class="ph"><span class="pht">{m.title}</span><span class="phw">{m.desc}</span></div>
            ))}
          </div>
        </div>
        <div class="sub">
          <h3>{content.ch01.survey.title}</h3>
          <p>{content.ch01.survey.body}</p>
          <div class="fig" style="margin-top:14px">
            <div class="metrics four" style="margin:0 0 10px">
              {content.ch01.survey.metrics.map((m) => (
                <div class="metric" style="padding:24px 22px"><div class="big">{m.value}</div><div class="lbl">{m.label}</div></div>
              ))}
            </div>
            <p style="font-size:12.5px;color:var(--ink-faint);margin:0 0 14px">{content.ch01.survey.note}</p>
            <p>{content.ch01.survey.closing}</p>
          </div>
        </div>
      </section>

      <!-- 02 挑戰與洞察 -->
      <section class="cx-sec" id="s2" data-sec>
        <span class="secnum">{content.ch02.num}</span>
        <h2 class="lbl">{content.ch02.label}</h2>
        <p class="intro">{content.ch02.intro}</p>
        <div class="phases">
          {content.ch02.stats.map((s) => (
            <div class="ph">
              <span class="pht">{s.title}</span>
              <span style="display:block;font-size:11.5px;font-weight:600;letter-spacing:.08em;color:var(--clay);margin-top:2px">{s.tag}</span>
              <span class="phw">{s.desc}</span>
            </div>
          ))}
        </div>

        <div class="sub">
          <h3>{content.ch02.sampling.title}</h3>
          <p>{content.ch02.sampling.body}</p>
          <div class="smap">
            <div class="sgroup">
              <div class="glabel">{content.ch02.sampling.groupMain.label}<span>{content.ch02.sampling.groupMain.sub}</span></div>
              {content.ch02.sampling.groupMain.rows.map((r) => (
                <div class="srow"><b>{r.name}</b>{r.tags.map((t) => <span class={t.hot ? 'st hot' : 'st'}>{t.text}</span>)}<span class="sd">{r.desc}</span></div>
              ))}
            </div>
            <div class="sgroup check">
              <div class="glabel">{content.ch02.sampling.groupCheck.label}<span>{content.ch02.sampling.groupCheck.sub}</span></div>
              {content.ch02.sampling.groupCheck.rows.map((r) => (
                <div class="srow"><b>{r.name}</b>{r.tags.map((t) => <span class={t.hot ? 'st hot' : 'st'}>{t.text}</span>)}<span class="sd">{r.desc}</span></div>
              ))}
            </div>
          </div>
          <p><Fragment set:html={content.ch02.sampling.closingHtml} /></p>
        </div>
        <div class="sub">
          <h3>{content.ch02.failure.title}</h3>
          <p>{content.ch02.failure.body}</p>
          <div class="phases">
            {content.ch02.failure.phases.map((p) => (
              <div class="ph">
                <span class="pht" style="font-size:15.5px;color:var(--clay)">{p.title}</span>
                <span class="phw">{p.desc}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="sub">
          <h3>{content.ch02.journey.title}</h3>
          <p>{content.ch02.journey.body}</p>
          <div class="fig"><img src={content.ch02.journey.figure.src} alt={content.ch02.journey.figure.alt} loading="lazy" /><div class="cap">{content.ch02.journey.figure.caption}</div></div>
          <p>{content.ch02.journey.closing}</p>
        </div>

        <div class="sub">
          <h3>{content.ch02.insightTable.title}</h3>
          <table class="mtable">
            <thead>
              <tr><th>{content.ch02.insightTable.headers.scenario}</th><th>{content.ch02.insightTable.headers.limitation}</th><th>{content.ch02.insightTable.headers.design}</th></tr>
            </thead>
            <tbody>
              {content.ch02.insightTable.rows.map((r) => (
                <tr><td>{r.scenario}</td><td>{r.limitation}</td><td>{r.design}</td></tr>
              ))}
            </tbody>
          </table>
          <p>{content.ch02.insightTable.closing}</p>
        </div>

        <div class="sub">
          <h3>{content.ch02.needs.title}</h3>
          <p>{content.ch02.needs.body}</p>
          <div class="consensus">
            {content.ch02.needs.items.map((c) => (
              <div class="citem stacked">
                <span class="phase-tag">{c.phase}</span>
                <b>{c.title}</b>
                <span class="desc">{c.desc}</span>
              </div>
            ))}
          </div>
          <p>{content.ch02.needs.closing}</p>
        </div>

        <div class="sub">
          <h3>{content.ch02.assumption.title}</h3>
          <div class="dcard" style="margin-top:16px">
            <h4>{content.ch02.assumption.cardTitle}</h4>
            <div class="dline dfind"><span class="k">{content.ch02.assumption.before.label}</span><span>{content.ch02.assumption.before.text}</span></div>
            <div class="dline dsee"><span class="k">{content.ch02.assumption.finding.label}</span><span>{content.ch02.assumption.finding.text}</span></div>
            <div class="dline dwin"><span class="k">{content.ch02.assumption.adjust.label}</span><span>{content.ch02.assumption.adjust.text}</span></div>
          </div>
          <p style="margin-top:16px">{content.ch02.assumption.closing}</p>
        </div>

      </section>

      <!-- 03 設計決策 -->
      <section class="cx-sec" id="s3" data-sec>
        <span class="secnum">{content.ch03.num}</span>
        <h2 class="lbl">{content.ch03.label}</h2>
        <p class="intro">{content.ch03.intro}</p>
        <div class="sub">
          <h3>{content.ch03.reallocation.title}</h3>
          <p>{content.ch03.reallocation.body}</p>
          <div class="phases">
            <div class="ph">
              <span class="pht">{content.ch03.reallocation.phases.pre.title}</span>
              <span style="display:block;font-size:11.5px;font-weight:600;letter-spacing:.08em;color:var(--clay);margin-top:2px">{content.ch03.reallocation.phases.pre.tag}</span>
              <span class="phw">{content.ch03.reallocation.phases.pre.desc}</span>
            </div>
            <div class="ph hot">
              <span class="pht">{content.ch03.reallocation.phases.during.title}</span>
              <span style="display:block;font-size:11.5px;font-weight:600;letter-spacing:.08em;color:var(--clay);margin-top:2px">{content.ch03.reallocation.phases.during.tag}</span>
              <span class="phw" style="color:var(--ink-soft);font-weight:400">{content.ch03.reallocation.phases.during.desc}</span>
            </div>
            <div class="ph">
              <span class="pht">{content.ch03.reallocation.phases.post.title}</span>
              <span style="display:block;font-size:11.5px;font-weight:600;letter-spacing:.08em;color:var(--clay);margin-top:2px">{content.ch03.reallocation.phases.post.tag}</span>
              <span class="phw">{content.ch03.reallocation.phases.post.desc}</span>
            </div>
          </div>
          <div class="fig"><img src={content.ch03.reallocation.figure.src} alt={content.ch03.reallocation.figure.alt} loading="lazy" /></div>
          <p style="margin-top:14px">{content.ch03.reallocation.closing}</p>
        </div>

        <div class="sub">
          <h3>{content.ch03.versus.title}</h3>
          <div class="versus">
            <div class="vopt lose">
              <span class="vtag">{content.ch03.versus.lose.tag}</span>
              <div class="vt">{content.ch03.versus.lose.title}</div>
              <p>{content.ch03.versus.lose.body}</p>
            </div>
            <div class="vs">vs</div>
            <div class="vopt win">
              <span class="vtag">{content.ch03.versus.win.tag}</span>
              <div class="vt">{content.ch03.versus.win.title}</div>
              <p>{content.ch03.versus.win.body}</p>
            </div>
          </div>
          <p style="margin-top:16px">{content.ch03.versus.closing}</p>
        </div>

        <div class="sub">
          <h3>{content.ch03.decisions.title}</h3>
          <p>{content.ch03.decisions.body}</p>
          <div class="dcards">
            {content.ch03.decisions.cards.map((d) => (
              <div class="dcard">
                <span class="dph">{d.phase}</span>
                <span class="dnum">{d.num}</span>
                <h4>{d.title}</h4>
                <span class="dsrc">{d.source}</span>
                <div class="dline dwin"><span class="k">{d.win.label}</span><span>{d.win.text}</span></div>
                <div class="dline dlose"><span class="k">{d.lose.label}</span><span>{d.lose.text}</span></div>
              </div>
            ))}
          </div>
        </div>
        <!-- Functional Map（暫時隱藏）
        <div class="sub">
          <h3>Functional Map</h3>
          <p>從三階段展開的完整功能地圖，作為介面設計的藍圖。</p>
          <div class="fig"><img src="/assets/images/project/UIUX/web/quake/functional-map.jpg" alt="Functional Map 完整功能地圖" loading="lazy" /></div>
        </div>
        -->
        <div class="sub">
          <h3>{content.ch03.flows.title}</h3>
          <p>{content.ch03.flows.body}</p>
          {content.ch03.flows.figures.map((f) => (
            <div class="fig"><img src={f.src} alt={f.alt} loading="lazy" /><div class="cap">{f.cap1}</div><div class="cap">{f.cap2}</div></div>
          ))}
        </div>
      </section>

    </div>
  </div>

  <!-- 04 介面設計（深色霓虹展示區） -->
  <section class="uidark" id="s4" data-sec>
    <div class="uidark-inner">
      <span class="k">{content.ch04.num}</span>
      <h2>{content.ch04.label}</h2>
      <p class="lede">{content.ch04.lede}</p>

      <div class="uvideo">
        <video controls playsinline preload="none" poster={content.ch04.introVideo.poster}>
          <source src={content.ch04.introVideo.src} type="video/mp4" />
        </video>
        <div class="cap">{content.ch04.introVideo.caption}</div>
      </div>

      <!-- Style Guide -->
      <div class="uphase">
        <span class="pk">{content.ch04.styleguide.pk}</span>
        <h3>{content.ch04.styleguide.title}</h3>
        <p>{content.ch04.styleguide.body}</p>
        <div class="styleguide"><img src={content.ch04.styleguide.image.src} alt={content.ch04.styleguide.image.alt} loading="lazy" /></div>
        <div class="sg-hint">{content.ch04.styleguide.hint}</div>
      </div>

      <!-- 震時 -->
      <div class="uphase">
        <span class="pk">{content.ch04.response.pk}</span>
        <h3>{content.ch04.response.title}</h3>
        <p>{content.ch04.response.body}</p>
        {content.ch04.response.images.map((img) => (
          <div class="uwide"><img src={img.src} alt={img.alt} loading="lazy" /></div>
        ))}

        <!-- 警報聲設計 -->
        <div class="uphase" style="margin-top:44px">
          <span class="pk">{content.ch04.sound.pk}</span>
          <h3>{content.ch04.sound.title}</h3>
          <p>{content.ch04.sound.body}</p>
          <div class="usounds">
            <div class="usound">
              <span class="lv">{content.ch04.sound.levels.low.level}</span>
              <h4>{content.ch04.sound.levels.low.title}</h4>
              <p>{content.ch04.sound.levels.low.desc}</p>
              <audio controls preload="none" src={content.ch04.sound.levels.low.audio}></audio>
            </div>
            <div class="usound mid">
              <span class="lv">{content.ch04.sound.levels.mid.level}</span>
              <h4>{content.ch04.sound.levels.mid.title}</h4>
              <p>{content.ch04.sound.levels.mid.desc}</p>
              <audio controls preload="none" src={content.ch04.sound.levels.mid.audio}></audio>
            </div>
            <div class="usound high">
              <span class="lv">{content.ch04.sound.levels.high.level}</span>
              <h4>{content.ch04.sound.levels.high.title}</h4>
              <p>{content.ch04.sound.levels.high.desc}</p>
              <audio controls preload="none" src={content.ch04.sound.levels.high.audio}></audio>
            </div>
          </div>
        </div>
      </div>

      <!-- 震前 -->
      <div class="uphase">
        <span class="pk">{content.ch04.prepare.pk}</span>
        <h3>{content.ch04.prepare.title}</h3>
        <p>{content.ch04.prepare.body}</p>
        {content.ch04.prepare.images.map((img) => (
          <div class="uwide"><img src={img.src} alt={img.alt} loading="lazy" /></div>
        ))}
      </div>

      <!-- 震後 -->
      <div class="uphase">
        <span class="pk">{content.ch04.recover.pk}</span>
        <h3>{content.ch04.recover.title}</h3>
        <p>{content.ch04.recover.body}</p>
        <p class="note">{content.ch04.recover.note}</p>
        {content.ch04.recover.images.map((img) => (
          <div class="uwide"><img src={img.src} alt={img.alt} loading="lazy" /></div>
        ))}
      </div>

      <!-- Prototype 互動展示 -->
      <div class="uphase">
        <span class="pk">{content.ch04.prototype.pk}</span>
        <h3>{content.ch04.prototype.title}</h3>
        <p>{content.ch04.prototype.body}</p>
        <div class="uclips">
          {content.ch04.prototype.clips.map((c) => (
            <div class="uclip"><video class="uclipv" muted loop playsinline preload="metadata" poster={c.poster}><source src={c.src} type="video/mp4" /></video><div class="cap">{c.caption}</div></div>
          ))}
        </div>
      </div>

      <!-- 易用性測試 -->
      <div class="uphase">
        <span class="pk">{content.ch04.usability.pk}</span>
        <h3>{content.ch04.usability.title}</h3>
        <p>{content.ch04.usability.body}</p>

        <div class="ufindings">
          <p class="fnote">{content.ch04.usability.findingsNote}</p>
          {content.ch04.usability.findings.map((f) => (
            <div class="ffind">
              <h4>{f.title}</h4>
              <p>{f.body}</p>
            </div>
          ))}
        </div>

        <div class="uvideo">
          <video controls playsinline preload="none" poster={content.ch04.usability.video.poster}>
            <source src={content.ch04.usability.video.src} type="video/mp4" />
          </video>
          <div class="cap">{content.ch04.usability.video.caption}</div>
        </div>
      </div>

      <div class="uphase">
        <span class="pk">{content.ch04.feedback.pk}</span>
        <h3>{content.ch04.feedback.title}</h3>
        <p>{content.ch04.feedback.body}</p>
      </div>
<!-- 
      <div class="uphase">
        <span class="pk">Next Step</span>
        <h3>驗證範圍與限制</h3>
        <p>本案完成至可操作的概念原型，現階段主要驗證資訊理解、操作方式與流程銜接，尚未串接官方地震警報、即時導航、政府公告與專業建物檢查服務。因此，現有測試結果不能代表系統在真實地震、斷網與高壓情境下的實際表現。</p>
      </div>
    </div> -->
    </div>
  </section>

  <section class="next">
    <div class="wrap">
      <span class="eyebrow">{content.next.eyebrow}</span>
      <a href={content.next.href}>{content.next.label}</a>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-cols">
    <div class="fcol-links">
      <span class="fk">{site.footerCase.menuLabel}</span>
      {site.footerCase.menuLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="fcol-links">
      <span class="fk">{site.footerCase.reachLabel}</span>
      <a href={site.footerCase.email.href}>{site.footerCase.email.label}</a>
      <a href={site.footerCase.cv.href} download>{site.footerCase.cv.label}</a>
    </div>
  </div>
  <div class="wrap foot">
    <span>{site.footerCase.copyright}</span>
    <span>{site.footerCase.tagline}</span>
  </div>
</footer>

<script is:inline>
  // 左側章節錨點：捲動高亮
  const links = [...document.querySelectorAll('.cx-nav a')];
  const map = {}; links.forEach(a => map[a.getAttribute('href')] = a);
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const a = map['#' + e.target.id];
        if (a) a.classList.add('active');
      }
    });
  }, { rootMargin: '-25% 0px -65% 0px' });
  document.querySelectorAll('[data-sec]').forEach(s => io.observe(s));

  // 互動 clip：滑到才播、離開就停（省效能）
  const cio = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      const v = e.target;
      if (e.isIntersecting) { v.play().catch(() => {}); }
      else { v.pause(); }
    });
  }, { threshold: 0.35 });
  document.querySelectorAll('.uclipv').forEach(v => cio.observe(v));
</script>

<script is:inline src="/assets/zoom.js" defer></script>

</Base>
<style is:global>
  /* 本頁取樣表：兩組同為中性框線，情境標籤優先於姓名 */
  .smap .srow b { font-family: "Hanken Grotesk", system-ui, sans-serif; font-size: 12.5px; font-weight: 600; color: var(--ink-faint); }
  .smap .st { font-size: 13px; font-weight: 600; color: var(--ink); }
  .smap .st.hot { color: var(--clay); border-color: var(--clay); }
  /* 需求卡：階段 pill 在左上，標題與說明分層 */
  .consensus .citem.stacked { flex-direction: column; align-items: flex-start; gap: 5px; padding: 13px 16px; }
  .consensus .citem.stacked .phase-tag { font-size: 10.5px; font-weight: 600; letter-spacing: .06em; color: var(--ink-soft); background: var(--paper-2); border: 1px solid var(--line); border-radius: 100px; padding: 1.5px 9px; }
  .consensus .citem.stacked b { font-size: 14.5px; }
  .consensus .citem.stacked .desc { font-size: 13px; color: var(--ink-soft); line-height: 1.55; }
</style>
