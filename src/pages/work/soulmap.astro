---
import Base from '../../layouts/Base.astro';
import content from '../../content/work/soulmap.json';
import site from '../../content/site.json';
---
<Base title={content.seo.title} description={content.seo.description}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/case.css" /></Fragment>

<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">Brynn<span>.</span></a>
    <a class="back" href="/#work">{site.topbar.back}</a>
  </div>
</div>

<main>
  <!-- 滿版 hero -->
  <div class="cx-herobanner">
    <img src={content.hero.coverSrc} alt={content.hero.coverAlt} />
  </div>

  <!-- 標題 -->
  <div class="cx-title">
    <span class="eyebrow">{content.hero.eyebrow}</span>
    <h1 class="display">{content.hero.title}</h1>
    <p class="lead">{content.hero.lead}</p>
  </div>

  <!-- meta -->
  <dl class="cx-metarow">
    {content.meta.map(m => (
      <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
    ))}
  </dl>

  <!-- 左導覽 + 敘事 -->
  <div class="cx">
    <aside class="cx-nav">
      <ul>
        <li><a href="#s1" class="active">{content.ch01.label}</a></li>
        <li><a href="#s2">{content.ch02.label}</a></li>
        <li><a href="#s3">{content.ch03.label}</a></li>
        <li><a href="#s4">{content.ch04.label}</a></li>
      </ul>
    </aside>

    <div class="cx-main">

      <!-- 01 背景與目標 -->
      <section class="cx-sec" id="s1" data-sec>
        <span class="secnum">01</span>
        <h2 class="lbl">{content.ch01.label}</h2>
        <p class="intro">{content.ch01.intro}</p>
        <div class="sub">
          <h3>{content.ch01.goals.title}</h3>
          <ul class="facts">
            {content.ch01.goals.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="note">{content.ch01.goals.note}</p>
        </div>
      </section>

      <!-- 02 挑戰與洞察 -->
      <section class="cx-sec" id="s2" data-sec>
        <span class="secnum">02</span>
        <h2 class="lbl">{content.ch02.label}</h2>
        <p class="intro">{content.ch02.intro}</p>
        <div class="phases">
          {content.ch02.phases.map(p => (
            <div class="ph"><span class="pht">{p.title}</span><span class="phw">{p.detail}</span></div>
          ))}
        </div>

        <div class="sub">
          <h3>{content.ch02.research.title}</h3>
          <p>{content.ch02.research.body}</p>
          <div class="fig"><img src={content.ch02.research.image.src} alt={content.ch02.research.image.alt} loading="lazy" /><div class="cap">{content.ch02.research.image.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.persona.title}</h3>
          <p>{content.ch02.persona.body}</p>
          <p class="note">{content.ch02.persona.note}</p>
          <div class="fig"><img src={content.ch02.persona.image.src} alt={content.ch02.persona.image.alt} loading="lazy" /><div class="cap">{content.ch02.persona.image.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.journey.title}</h3>
          <p>{content.ch02.journey.body1}</p>
          <p>{content.ch02.journey.body2}</p>
          <div class="fig"><img src={content.ch02.journey.image.src} alt={content.ch02.journey.image.alt} loading="lazy" /><div class="cap">{content.ch02.journey.image.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.directions.title}</h3>
          <p>{content.ch02.directions.body}</p>
          <div class="fig"><img src={content.ch02.directions.image.src} alt={content.ch02.directions.image.alt} loading="lazy" /></div>
        </div>
      </section>

      <!-- 03 設計決策 -->
      <section class="cx-sec" id="s3" data-sec>
        <span class="secnum">03</span>
        <h2 class="lbl">{content.ch03.label}</h2>
        <p class="intro">{content.ch03.intro}</p>
        <div class="versus">
          <div class="vopt lose">
            <span class="vtag">{content.ch03.versus.lose.tag}</span>
            <div class="vt">{content.ch03.versus.lose.title}</div>
            <p>{content.ch03.versus.lose.body}</p>
          </div>
          <div class="vs">vs</div>
          <div class="vopt win">
            <span class="vtag">{content.ch03.versus.win.tag}</span>
            <div class="vt">{content.ch03.versus.win.title}</div>
            <p>{content.ch03.versus.win.body}</p>
          </div>
        </div>
        <p class="intro" style="margin-top:16px">{content.ch03.conclusion}</p>

        <div class="sub">
          <h3>{content.ch03.stages.title}</h3>
          <ul class="facts">
            {content.ch03.stages.items.map(s => (
              <li><b>{s.title}</b>｜{s.desc}</li>
            ))}
          </ul>
          <p class="note">{content.ch03.stages.note}</p>
        </div>

        <div class="sub">
          <h3>{content.ch03.decisions.title}</h3>
          <div class="dcards">
            {content.ch03.decisions.items.map(d => (
              <div class="dcard">
                <span class="dph">{d.phase}</span>
                <span class="dnum">{d.num}</span>
                <h4>{d.title}</h4>
                <span class="dsrc">{d.basis}</span>
                <div class="dline dwin"><span class="k">設計選擇</span><span>{d.choice}</span></div>
                <div class="dline dlose"><span class="k">取捨</span><span>{d.tradeoff}</span></div>
              </div>
            ))}
          </div>
        </div>

        <div class="sub">
          <h3>{content.ch03.extension.title}</h3>
          <p>{content.ch03.extension.body}</p>
        </div>

        <div class="sub">
          <h3>{content.ch03.architecture.title}</h3>
          <p>{content.ch03.architecture.body}</p>
          <div class="fig"><img src={content.ch03.architecture.functionalMap.src} alt={content.ch03.architecture.functionalMap.alt} loading="lazy" /><div class="cap">{content.ch03.architecture.functionalMap.caption}</div></div>
          <div class="fig"><img src={content.ch03.architecture.userFlow.src} alt={content.ch03.architecture.userFlow.alt} loading="lazy" /><div class="cap">{content.ch03.architecture.userFlow.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch03.wireframe.title}</h3>
          <p>{content.ch03.wireframe.body}</p>
          <div class="fig"><img src={content.ch03.wireframe.image.src} alt={content.ch03.wireframe.image.alt} loading="lazy" /></div>
        </div>
      </section>

    </div>
  </div>

  <!-- 04 介面設計（淺色展示區） -->
  <section class="uilight" id="s4" data-sec>
    <div class="uhead">
      <span class="k">04</span>
      <h2>{content.ch04.label}</h2>
      <p>{content.ch04.intro}</p>
    </div>

    <div class="ui-sub">
      <span class="k">{content.ch04.styleguide.k}</span>
      <h3>{content.ch04.styleguide.title}</h3>
      <p>{content.ch04.styleguide.body}</p>
    </div>
    <div class="wide">
      <div class="sgbox"><img src={content.ch04.styleguide.image.src} alt={content.ch04.styleguide.image.alt} loading="lazy" /></div>
      <div class="boxhint">{content.ch04.styleguide.hint}</div>
    </div>

    <div class="ui-sub">
      <span class="k">{content.ch04.character.k}</span>
      <h3>{content.ch04.character.title}</h3>
      <p>{content.ch04.character.body}</p>
    </div>
    <div class="wide"><img src={content.ch04.character.image.src} alt={content.ch04.character.image.alt} loading="lazy" /></div>

    {content.ch04.screens.map(s => (
      <Fragment>
        <div class="ui-sub">
          <span class="k">{s.k}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
        <div class="wide"><img src={s.image.src} alt={s.image.alt} loading="lazy" /></div>
      </Fragment>
    ))}

    <!-- <div class="ui-sub">
      <span class="k">Next Step</span>
      <h3>後續驗證方向</h3>
      <p>本案以桌面研究、競品分析與少量訪談建立初步設計方向，尚未進行易用性與長期使用測試。後續需要確認：初學者是否理解分階段內容、先體驗再登入是否降低開始負擔、心情紀錄是否容易略過，以及本週目標完成率是否能被正確理解。內容路徑與冥想引導也需要由相關專業人員檢視。</p>
    </div> -->
  </section>

  <section class="next">
    <div class="wrap">
      <span class="eyebrow">{content.next.eyebrow}</span>
      <a href={content.next.href}>{content.next.label}</a>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-cols">
    <div class="fcol-links">
      <span class="fk">{site.footerCase.menuLabel}</span>
      {site.footerCase.menuLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="fcol-links">
      <span class="fk">{site.footerCase.reachLabel}</span>
      <a href={site.footerCase.email.href}>{site.footerCase.email.label}</a>
      <a href={site.footerCase.cv.href} download>{site.footerCase.cv.label}</a>
    </div>
  </div>
  <div class="wrap foot">
    <span>{site.footerCase.copyright}</span>
    <span>{site.footerCase.tagline}</span>
  </div>
</footer>

<script is:inline>
  // 左側章節錨點：捲動高亮
  const links = [...document.querySelectorAll('.cx-nav a')];
  const map = {}; links.forEach(a => map[a.getAttribute('href')] = a);
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const a = map['#' + e.target.id];
        if (a) a.classList.add('active');
      }
    });
  }, { rootMargin: '-25% 0px -65% 0px' });
  document.querySelectorAll('[data-sec]').forEach(s => io.observe(s));
</script>

<script is:inline src="/assets/zoom.js" defer></script>

</Base>
