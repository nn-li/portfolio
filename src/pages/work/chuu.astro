---
import Base from '../../layouts/Base.astro';
import content from '../../content/work/chuu.json';
import site from '../../content/site.json';
---
<Base title={content.title} description={content.description}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/case.css" /></Fragment>

<div class="topbar">
  <div class="wrap">
    <a class="brand" href="/">Brynn<span>.</span></a>
    <a class="back" href="/#work">{site.topbar.back}</a>
  </div>
</div>

<main>
  <!-- 滿版 hero -->
  <div class="cx-herobanner">
    <img src={content.hero.cover.src} alt={content.hero.cover.alt} />
  </div>

  <!-- 標題 -->
  <div class="cx-title">
    <span class="eyebrow">{content.hero.eyebrow}</span>
    <h1 class="display">{content.hero.heading}</h1>
    <p class="lead">{content.hero.lead}</p>
  </div>

  <!-- meta -->
  <dl class="cx-metarow">
    {content.hero.meta.map((m) => (
      <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
    ))}
  </dl>

  <!-- 左導覽 + 敘事 -->
  <div class="cx">
    <aside class="cx-nav">
      <ul>
        <li><a href="#s1" class="active">{content.ch01.title}</a></li>
        <li><a href="#s2">{content.ch02.title}</a></li>
        <li><a href="#s3">{content.ch03.title}</a></li>
        <li><a href="#s4">{content.ch04.title}</a></li>
      </ul>
    </aside>

    <div class="cx-main">

      <!-- 01 背景與目標 -->
      <section class="cx-sec" id="s1" data-sec>
        <span class="secnum">{content.ch01.num}</span>
        <h2 class="lbl">{content.ch01.title}</h2>
        <p class="intro">{content.ch01.intro}</p>
        <div class="sub">
          <h3>{content.ch01.goals.title}</h3>
          <ul class="facts">
            {content.ch01.goals.items.map((item) => (
              <li><b>{item.label}</b>｜{item.text}</li>
            ))}
          </ul>
        </div>
        <div class="sub">
          <h3>{content.ch01.role.title}</h3>
          <div class="phases">
            {content.ch01.role.phases.map((p) => (
              <div class="ph"><span class="pht">{p.title}</span><span class="phw">{p.text}</span></div>
            ))}
          </div>
        </div>
        <p class="note">{content.ch01.note}</p>
      </section>

      <!-- 02 挑戰與洞察 -->
      <section class="cx-sec" id="s2" data-sec>
        <span class="secnum">{content.ch02.num}</span>
        <h2 class="lbl">{content.ch02.title}</h2>
        <p class="intro">{content.ch02.intro}</p>

        <div class="sub">
          <h3>{content.ch02.competitive.title}</h3>
          <p>{content.ch02.competitive.body}</p>
          <div class="fig"><img src={content.ch02.competitive.figure.src} alt={content.ch02.competitive.figure.alt} loading="lazy" /><div class="cap">{content.ch02.competitive.figure.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.userFeedback.title}</h3>
          <p>{content.ch02.userFeedback.body}</p>
          <div class="fig"><img src={content.ch02.userFeedback.figure.src} alt={content.ch02.userFeedback.figure.alt} loading="lazy" /><div class="cap">{content.ch02.userFeedback.figure.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.journey.title}</h3>
          <p>{content.ch02.journey.body}</p>
          <div class="fig"><img src={content.ch02.journey.figure.src} alt={content.ch02.journey.figure.alt} loading="lazy" /><div class="cap">{content.ch02.journey.figure.caption}</div></div>
        </div>
        <div class="sub">
          <h3>{content.ch02.consensus.title}</h3>
          <div class="consensus">
            {content.ch02.consensus.items.map((item) => (
              <div class="citem"><span><b>{item.label}</b>｜{item.text}</span></div>
            ))}
          </div>
        </div>

        <div class="sub">
          <h3>{content.ch02.structure.title}</h3>
          <p>{content.ch02.structure.functionalMap.body}</p>
          <div class="fig"><img src={content.ch02.structure.functionalMap.figure.src} alt={content.ch02.structure.functionalMap.figure.alt} loading="lazy" /><div class="cap">{content.ch02.structure.functionalMap.figure.caption}</div></div>
          <p>{content.ch02.structure.userFlow.body}</p>
          <div class="fig"><img src={content.ch02.structure.userFlow.figure.src} alt={content.ch02.structure.userFlow.figure.alt} loading="lazy" /><div class="cap">{content.ch02.structure.userFlow.figure.caption}</div></div>
          <p>{content.ch02.structure.wireframe.body}</p>
          <div class="fig"><img src={content.ch02.structure.wireframe.figure.src} alt={content.ch02.structure.wireframe.figure.alt} loading="lazy" /></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.prototype.title}</h3>
          <p>{content.ch02.prototype.body}</p>
          <!-- <p class="note">本輪以質化操作回饋為主，未進行量化比較，因此不作完成率或成效推論。</p> -->
          <div class="fig"><img src={content.ch02.prototype.figure.src} alt={content.ch02.prototype.figure.alt} loading="lazy" /><div class="cap">{content.ch02.prototype.figure.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.adjustments.title}</h3>
          <ul class="facts">
            {content.ch02.adjustments.items.map((item) => (
              <li><b>{item.label}</b>｜{item.text}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 03 設計決策 -->
      <section class="cx-sec" id="s3" data-sec>
        <span class="secnum">{content.ch03.num}</span>
        <h2 class="lbl">{content.ch03.title}</h2>
        <p class="intro">{content.ch03.intro}</p>
        <div class="dcard" style="margin-top:20px">
          <span class="dnum">{content.ch03.coreDecision.num}</span>
          <h4>{content.ch03.coreDecision.title}</h4>
          <div class="dline dfind"><span class="k">{content.ch03.coreDecision.findingLabel}</span><span>{content.ch03.coreDecision.finding}</span></div>
          <div class="dline dwin"><span class="k">{content.ch03.coreDecision.decisionLabel}</span><span>{content.ch03.coreDecision.decision}</span></div>
          <div class="dline dlose"><span class="k">{content.ch03.coreDecision.tradeoffLabel}</span><span>{content.ch03.coreDecision.tradeoff}</span></div>
        </div>

        <div class="sub">
          <h3>{content.ch03.extensions.title}</h3>
          <div class="dcards three">
            {content.ch03.extensions.cards.map((c) => (
              <div class="dcard">
                <span class="dph">{c.phase}</span>
                <span class="dnum">{c.num}</span>
                <h4>{c.title}</h4>
                <div class="dline dfind"><span class="k">{c.findingLabel}</span><span>{c.finding}</span></div>
                <div class="dline dwin"><span class="k">{c.decisionLabel}</span><span>{c.decision}</span></div>
                <div class="dline dlose"><span class="k">{c.tradeoffLabel}</span><span>{c.tradeoff}</span></div>
              </div>
            ))}
          </div>
        </div>
      </section>

    </div>
  </div>

  <!-- 04 介面設計（淺色展示區） -->
  <section class="uilight" id="s4" data-sec>
    <div class="uhead">
      <span class="k">{content.ch04.num}</span>
      <h2>{content.ch04.title}</h2>
      <p>{content.ch04.intro}</p>
    </div>

    <div class="ui-sub">
      <span class="k">{content.ch04.styleguide.eyebrow}</span>
      <h3>{content.ch04.styleguide.title}</h3>
      <p>{content.ch04.styleguide.body}</p>
    </div>
    <div class="wide">
      <div class="sgbox"><img src={content.ch04.styleguide.image.src} alt={content.ch04.styleguide.image.alt} loading="lazy" /></div>
      <div class="boxhint">{content.ch04.styleguide.hint}</div>
    </div>

    {content.ch04.screens.map((s) => (
      <>
        <div class="ui-sub">
          <span class="k">{s.eyebrow}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
        <div class="wide"><img src={s.image.src} alt={s.image.alt} loading="lazy" /></div>
      </>
    ))}

    <div class="ui-sub">
      <span class="k">{content.ch04.responsive.eyebrow}</span>
      <h3>{content.ch04.responsive.title}</h3>
      <p>{content.ch04.responsive.body}</p>
    </div>
    <div class="wide"><img src={content.ch04.responsive.image.src} alt={content.ch04.responsive.image.alt} loading="lazy" /></div>

    <div class="ui-sub">
      <span class="k">{content.ch04.frontend.eyebrow}</span>
      <h3>{content.ch04.frontend.title}</h3>
      <p>{content.ch04.frontend.body1}</p>
      <p>{content.ch04.frontend.body2}</p>
    </div>
    {content.ch04.frontend.figures.map((f) => (
      <div class="wide">
        <img src={f.src} alt={f.alt} loading="lazy" />
        <div class="cap">{f.caption}</div>
      </div>
    ))}

    {content.ch04.extendedScreens.map((s) => (
      <>
        <div class="ui-sub">
          <span class="k">{s.eyebrow}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
        <div class="wide"><img src={s.image.src} alt={s.image.alt} loading="lazy" /></div>
      </>
    ))}


  </section>

  <section class="next">
    <div class="wrap">
      <span class="eyebrow">{content.next.eyebrow}</span>
      <a href={content.next.href}>{content.next.title} →</a>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot-cols">
    <div class="fcol-links">
      <span class="fk">{site.footerCase.menuLabel}</span>
      {site.footerCase.menuLinks.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="fcol-links">
      <span class="fk">{site.footerCase.reachLabel}</span>
      <a href={site.footerCase.email.href}>{site.footerCase.email.label}</a>
      <a href={site.footerCase.cv.href} download>{site.footerCase.cv.label}</a>
    </div>
  </div>
  <div class="wrap foot">
    <span>{site.footerCase.copyright}</span>
    <span>{site.footerCase.tagline}</span>
  </div>
</footer>

<script is:inline>
  // 左側章節錨點：捲動高亮
  const links = [...document.querySelectorAll('.cx-nav a')];
  const map = {}; links.forEach(a => map[a.getAttribute('href')] = a);
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const a = map['#' + e.target.id];
        if (a) a.classList.add('active');
      }
    });
  }, { rootMargin: '-25% 0px -65% 0px' });
  document.querySelectorAll('[data-sec]').forEach(s => io.observe(s));
</script>

<script is:inline src="/assets/zoom.js" defer></script>

</Base>
