---
// Graphic 作品索引：五個平面專案圍成圓環，點擊各封面開啟該案作品集詳情。
// （檔名沿用 secret-dimension 以維持既有路由；內容已是五專案索引。）
import Base from '../../layouts/Base.astro';
import content from '../../content/work/secret-dimension.json';
import site from '../../content/site.json';
import EcSiteNav from '../../components/EcSiteNav.astro';
import EcSiteFooter from '../../components/EcSiteFooter.astro';
import EcCursor from '../../components/EcCursor.astro';
const total = content.projects.length;
const pad = (n) => String(n).padStart(2, '0');
---
<Base title={content.seo.title} description={content.seo.description}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
  </Fragment>

<EcSiteNav />

<main class="sd">
  <!-- 眉標 -->
  <div class="sd-eyebrow-wrap"><span class="sd-eyebrow">{content.hero.eyebrow}</span></div>

  <!-- 五專案圍成一個環（等距、直立、不遮擋；hover 放大、點擊開該案作品集） -->
  <section class="sd-stage" aria-label="Graphic 作品">
    <div class="sd-stage-scene" id="sdScene">
      {content.projects.map((pr, i) => (
        <figure class="sd-c3d" data-i={i} style={`--a:${(-90 + i * 72)}deg; --i:${i}; --delay:${(i * 0.1).toFixed(2)}s`}>
          <span class="sd-c3d-in"><img src={pr.cover} alt={pr.title} loading="lazy" /></span>
          <figcaption class="sd-c3d-cap">{pr.title}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 各專案詳情（點擊開啟） -->
  <div class="sd-details">
    {content.projects.map((pr, i) => (
      <article class="sd-detail" id={`sdDet-${i}`} aria-hidden="true">
        <button class="sd-detail-close" data-close aria-label="關閉">×</button>
        <div class="sd-detail-inner">
          <header class="sd-detail-head">
            <span class="sd-detail-eyebrow">GRAPHIC · {pad(i + 1)} / {pad(total)}</span>
            <h1 class="sd-detail-title display">{pr.title}</h1>
          </header>

          {pr.layout === 'case' ? (
            <div class="sd-case">
              {pr.heroGraphic && (
                <section class="sd-herographic">
                  <figure class="plate" style={`max-width:${pr.heroGraphic.w}px`}>
                    <img src={pr.heroGraphic.src} alt={pr.heroGraphic.alt} width={pr.heroGraphic.w} loading="lazy" />
                  </figure>
                </section>
              )}
              <div class="sd-rows">
                {pr.rows.map((r) => (
                  <section class={`sd-row ${r.side === '' ? 'textonly' : r.side === 'right' ? 'img-right' : 'img-left'}`}>
                    {r.side !== '' && (
                      <div class="sd-media">
                        {r.images.map((im) => (
                          <figure class="plate" style={`max-width:${im.w}px`}>
                            <img src={im.src} alt={im.alt} width={im.w} loading="lazy" />
                          </figure>
                        ))}
                      </div>
                    )}
                    <div class="sd-cell">
                      {r.label && (<div class="sd-rowhead"><span class="sd-rowlabel">{r.label}</span><span class="sd-line"></span></div>)}
                      {r.body && <p class="sd-body">{r.body}</p>}
                      {r.quote && <p class="sd-inlinequote">{r.quote}</p>}
                      {r.chart && (
                        <div class="sd-chart">
                          <h3 class="sd-charttitle">{pr.colorChart.title}</h3>
                          <div class="sd-bands">{pr.colorChart.bands.map((b) => <span>{b}</span>)}</div>
                          <ul class="sd-swatches">
                            {pr.colorChart.items.map((it) => (<li><span class="sw" style={`background:${it.sw}`}></span>{it.label}</li>))}
                          </ul>
                        </div>
                      )}
                    </div>
                  </section>
                ))}
              </div>
              {pr.finalImage && (
                <section class="sd-final">
                  <figure class="plate" style={`max-width:${pr.finalImage.w}px`}>
                    <img src={pr.finalImage.src} alt={pr.finalImage.alt} width={pr.finalImage.w} loading="lazy" />
                  </figure>
                </section>
              )}
            </div>
          ) : (
            <div class="sd-detail-gallery">
              {pr.images.map((src) => (
                <figure class="plate"><img src={src} alt={pr.title} loading="lazy" /></figure>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <!-- next -->
  <section class="sd-next">
    <a href={content.next.href}>{content.next.label}</a>
  </section>
</main>

<EcSiteFooter />

<style is:global>
  body:has(.sd) { background: var(--paper); }
</style>

<style>
  .sd { --ink: #141414; --soft: #4A4A4A; --faint: #8A8A8A; --line: #eaeaea; --paper: #fff; color: var(--ink); }
  * { box-sizing: border-box; }

  .sd { max-width: 1200px; margin: 0 auto; padding: 0 40px 40px; }

  /* eyebrow */
  .sd-eyebrow-wrap { padding: 80px 0 8px; }
  .sd-eyebrow { font-family: "DotGothic16", monospace; font-size: 19px; letter-spacing: .05em; color: var(--ink); }

  /* 畫框（通用） */
  .plate {
    margin: 0; background: var(--paper);
    border: 1px solid var(--line); border-radius: 2px; overflow: hidden;
    box-shadow: 0 16px 40px -22px rgba(0,0,0,.4);
  }
  .plate img { display: block; max-width: 100%; height: auto; }

  /* ===== 五專案圓環 ===== */
  .sd-stage { margin: 0 -40px; }
  .sd-stage-scene {
    position: relative; width: 100%; height: 84vh; min-height: 640px;
    --R: clamp(170px, 20vw, 245px);
  }
  .sd-c3d {
    position: absolute; left: 50%; top: 50%; margin: 0;
    width: clamp(128px, 13vw, 162px); aspect-ratio: 215 / 320;
    transform: translate(-50%, -50%) rotate(calc(var(--i) * 5deg)) scale(.46);   /* 收攏中心 */
    transition: transform .95s cubic-bezier(.16, 1, .3, 1);
    transition-delay: var(--delay);
    cursor: pointer; z-index: 1;
  }
  .sd-c3d.in {   /* 散成圓環 */
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(calc(-1 * var(--R))) rotate(calc(-1 * var(--a)));
  }
  .sd-c3d-in {
    display: block; width: 100%; height: 100%;
    border-radius: 3px; overflow: hidden; background: #0b0b0b;
    box-shadow: 0 40px 70px -30px rgba(0,0,0,.5);
    animation: sdfloat 7s ease-in-out infinite; animation-delay: var(--delay);
  }
  .sd-c3d img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s cubic-bezier(.16,1,.3,1); }
  .sd-c3d-cap {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    margin-top: 12px; white-space: nowrap;
    font-family: "DotGothic16", monospace; font-size: 12.5px; letter-spacing: .08em; color: var(--soft);
    opacity: 0; transition: opacity .3s;
  }
  .sd-c3d.in:hover {
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(calc(-1 * var(--R))) rotate(calc(-1 * var(--a))) scale(1.2);
    z-index: 999;
  }
  .sd-c3d.in:hover img { transform: scale(1.05); }
  .sd-c3d.in:hover .sd-c3d-cap { opacity: 1; }
  @keyframes sdfloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  /* ===== 專案詳情（覆蓋層） ===== */
  .sd-detail {
    position: fixed; inset: 0; z-index: 200; overflow-y: auto; overscroll-behavior: contain;
    background: #f7f7f5;
    opacity: 0; visibility: hidden; transform: scale(.98);
    transition: opacity .45s ease, transform .5s cubic-bezier(.16,1,.3,1), visibility .45s;
  }
  .sd-detail.on { opacity: 1; visibility: visible; transform: none; }
  .sd-detail-close {
    position: fixed; top: 20px; right: 28px; z-index: 3;
    background: none; border: 0; font-size: 30px; line-height: 1; cursor: pointer;
    color: #141414; opacity: .55; transition: opacity .2s;
  }
  .sd-detail-close:hover { opacity: 1; }
  .sd-detail-inner { max-width: 860px; margin: 0 auto; padding: 92px 24px 90px; }
  .sd-detail-eyebrow { font-family: "DotGothic16", monospace; font-size: 12px; letter-spacing: .2em; color: #999; text-transform: uppercase; }
  .sd-detail-title { font-family: "Fraunces", serif; font-weight: 400; font-size: clamp(34px, 6vw, 62px); line-height: 1.04; letter-spacing: -.02em; margin: 14px 0 0; }
  .sd-detail-quote { font-family: "Fraunces", serif; font-size: clamp(18px, 2.4vw, 26px); line-height: 1.5; color: var(--soft); margin-top: 22px; max-width: 26ch; }
  .sd-detail-body { font-family: "Hanken Grotesk", sans-serif; font-size: 16px; line-height: 1.85; color: var(--soft); margin-top: 16px; max-width: 60ch; }
  .sd-detail-gallery { display: flex; flex-direction: column; gap: 26px; margin-top: 52px; }
  /* 展覽式捲動轉場：作品圖依序淡入上升 */
  .sd-detail .plate {
    opacity: 0; transform: translateY(30px);
    transition: opacity .9s cubic-bezier(.16,1,.3,1), transform .9s cubic-bezier(.16,1,.3,1);
  }
  .sd-detail .plate.show { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .sd-detail .plate { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ===== Secret Dimension 完整案例排版（overlay 內） ===== */
  .sd-case { margin-top: 40px; }
  .sd-herographic { display: flex; justify-content: center; margin: 0 0 64px; }
  .sd-rows { display: flex; flex-direction: column; gap: 72px; }
  .sd-row { display: flex; gap: 48px; align-items: center; }
  .sd-row.img-right { flex-direction: row-reverse; }
  .sd-row.textonly { display: block; }
  .sd-media { flex: 1 1 0; display: flex; gap: 20px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
  .sd-cell { flex: 1 1 0; }
  .sd-rowhead { display: flex; align-items: center; gap: 20px; margin-bottom: 20px; }
  .sd-rowlabel { font-family: "Fraunces", serif; font-size: 22px; letter-spacing: -.01em; color: var(--ink); white-space: nowrap; }
  .sd-line { height: 1px; flex: 1; background: var(--line); }
  .sd-body { font-family: "Hanken Grotesk", sans-serif; font-size: 16px; line-height: 1.85; color: var(--soft); }
  .sd-inlinequote { font-family: "Fraunces", serif; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.5; color: var(--ink); }
  .sd-row.textonly .sd-body { max-width: 62ch; font-size: 16.5px; }
  .sd-chart { margin-top: 4px; }
  .sd-charttitle { font-family: "Fraunces", serif; font-weight: 500; font-size: 22px; margin: 0 0 16px; }
  .sd-bands { display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 18px; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .sd-swatches { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .sd-swatches li { display: flex; align-items: center; gap: 12px; font-size: 15px; color: var(--soft); }
  .sd-swatches .sw { width: 18px; height: 18px; flex: none; border-radius: 50%; border: 1px solid var(--line); }
  .sd-final { display: flex; justify-content: center; margin: 80px 0 0; }

  /* next */
  .sd-next { text-align: center; padding: 40px 0; }
  .sd-next a { font-family: "Fraunces", serif; font-size: clamp(22px, 3vw, 32px); color: var(--ink); border-bottom: 1.5px solid transparent; }
  .sd-next a:hover { border-color: var(--ink); }

  @media (max-width: 820px) {
    .sd { padding-left: 20px; padding-right: 20px; }
    .sd-stage { margin: 0 -20px; }
    /* 手機：圓環改成可左右滑的海報帶 */
    .sd-stage-scene {
      box-sizing: border-box;
      height: auto; min-height: 0; --R: 0px;
      display: flex; gap: 14px; overflow-x: auto; overflow-y: hidden;
      padding: 30px 20px; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    }
    .sd-c3d {
      position: relative !important; left: auto !important; top: auto !important;
      transform: none !important; width: 62vw; flex: 0 0 auto; scroll-snap-align: center;
    }
    .sd-c3d-in { animation: none; }
    .sd-c3d-cap { position: static; transform: none; opacity: 1; margin-top: 10px; text-align: center; }
    .sd-detail-inner { padding: 84px 20px 80px; }
    .sd-row, .sd-row.img-right { flex-direction: column; gap: 24px; align-items: flex-start; }
    .sd-rows { gap: 56px; }
    .sd-herographic { margin-bottom: 48px; }
  }
</style>

<script is:inline>
  (function () {
    var scene = document.getElementById('sdScene');
    if (!scene) return;
    var cards = Array.prototype.slice.call(scene.querySelectorAll('.sd-c3d'));
    if (!cards.length) return;

    /* ===== 點擊 → 開啟該專案詳情 ===== */
    var details = cards.map(function (_, i) { return document.getElementById('sdDet-' + i); });
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function ensureReveal(d) {
      if (d.__io || reduce) { d.querySelectorAll('.plate').forEach(function (el) { el.classList.add('show'); }); return; }
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); } });
      }, { root: d, threshold: 0, rootMargin: '0px 0px -8% 0px' });
      d.querySelectorAll('.plate').forEach(function (el) { io.observe(el); });
      d.__io = io;
    }
    function openDetail(i) {
      var d = details[i]; if (!d) return;
      d.classList.add('on'); d.setAttribute('aria-hidden', 'false');
      d.scrollTop = 0; document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () { ensureReveal(d); });
    }
    function closeDetail(d) {
      d.classList.remove('on'); d.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    cards.forEach(function (c, i) { c.addEventListener('click', function () { openDetail(i); }); });
    details.forEach(function (d) {
      if (!d) return;
      d.querySelector('[data-close]').addEventListener('click', function () { closeDetail(d); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      details.forEach(function (d) { if (d && d.classList.contains('on')) closeDetail(d); });
    });
    function anyOpen() { return details.some(function (d) { return d && d.classList.contains('on'); }); }

    /* ===== 轉場：進場從中心散出成圓，之後循環「聚攏→散開」 ===== */
    var stage = scene.closest('.sd-stage') || scene;
    var hovering = false;
    stage.addEventListener('mouseenter', function () { hovering = true; });
    stage.addEventListener('mouseleave', function () { hovering = false; });
    function spread() { cards.forEach(function (c) { c.classList.add('in'); }); }
    function gather() { cards.forEach(function (c) { c.classList.remove('in'); }); }

    requestAnimationFrame(function () { requestAnimationFrame(spread); });

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !matchMedia('(max-width: 820px)').matches) {
      setInterval(function () {
        if (hovering || anyOpen()) return;
        gather();
        setTimeout(spread, 1500);
      }, 9000);
    }
  })();
</script>

<script is:inline src="/assets/zoom.js" defer></script>

<EcCursor />

</Base>
