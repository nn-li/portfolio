---
// Secret Dimension — 淡色畫廊版，保留 Framer 的雙欄交錯版面結構。
// 圖片以「畫框」呈現且鎖在原生尺寸內（不放大→不糊）。段落順序對齊 Framer。
import Base from '../../layouts/Base.astro';
import content from '../../content/work/secret-dimension.json';
import site from '../../content/site.json';
import EcSiteNav from '../../components/EcSiteNav.astro';
import EcSiteFooter from '../../components/EcSiteFooter.astro';
import EcCursor from '../../components/EcCursor.astro';
---
<Base title={content.seo.title} description={content.seo.description}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
  </Fragment>

<EcSiteNav />

<main class="sd">
  <!-- 眉標 -->
  <div class="sd-eyebrow-wrap"><span class="sd-eyebrow">{content.hero.eyebrow}</span></div>

  <!-- 最上方卡片牆 -->
  <section class="sd-cards">
    {content.cards.map((c) => (
      <figure class="plate sd-cardfig"><img src={c.src} alt={c.alt} loading="lazy" /></figure>
    ))}
  </section>

  <!-- 標題 + 金句 -->
  <section class="sd-lead">
    <h1 class="sd-title display">{content.hero.title}</h1>
    <p class="sd-quote">{content.hero.quote}</p>
  </section>

  <!-- 大圖（置中、鎖原生寬） -->
  <section class="sd-herographic">
    <figure class="plate" style={`max-width:${content.heroGraphic.w}px`}>
      <img src={content.heroGraphic.src} alt={content.heroGraphic.alt} width={content.heroGraphic.w} loading="lazy" />
    </figure>
  </section>

  <!-- 交錯雙欄 -->
  <div class="sd-rows">
    {content.rows.map((r) => (
      <section class={`sd-row ${r.side === '' ? 'textonly' : r.side === 'right' ? 'img-right' : 'img-left'}`}>
        {r.side !== '' && (
          <div class="sd-media">
            {r.images.map((im) => (
              <figure class="plate" style={`max-width:${im.w}px`}>
                <img src={im.src} alt={im.alt} width={im.w} loading="lazy" />
              </figure>
            ))}
          </div>
        )}
        <div class="sd-cell">
          {r.label && (
            <div class="sd-rowhead"><span class="sd-rowlabel">{r.label}</span><span class="sd-line"></span></div>
          )}
          {r.body && <p class="sd-body">{r.body}</p>}
          {r.quote && <p class="sd-inlinequote">{r.quote}</p>}
          {r.chart && (
            <div class="sd-chart">
              <h3 class="sd-charttitle">{content.colorChart.title}</h3>
              <div class="sd-bands">{content.colorChart.bands.map((b) => <span>{b}</span>)}</div>
              <ul class="sd-swatches">
                {content.colorChart.items.map((it) => (
                  <li><span class="sw" style={`background:${it.sw}`}></span>{it.label}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    ))}
  </div>

  <!-- 收尾（置中、鎖原生寬） -->
  <section class="sd-final">
    <figure class="plate" style={`max-width:${content.finalImage.w}px`}>
      <img src={content.finalImage.src} alt={content.finalImage.alt} width={content.finalImage.w} loading="lazy" />
    </figure>
  </section>

  <!-- next -->
  <section class="sd-next">
    <span class="sd-eyebrow-sm">{content.next.eyebrow}</span>
    <a href={content.next.href}>{content.next.label}</a>
  </section>
</main>

<EcSiteFooter />

<style is:global>
  body:has(.sd) { background: var(--paper); }
</style>

<style>
  .sd { --ink: #141414; --soft: #4A4A4A; --faint: #8A8A8A; --line: #eaeaea; --paper: #fff; color: var(--ink); }

  /* topbar */
  .sd-topbar {
    position: sticky; top: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 40px;
    background: rgba(255,255,255,.82); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .sd-brand { font-family: "Fraunces", serif; font-size: 20px; color: var(--ink); }
  .sd-brand span { color: var(--accent); }
  .sd-back { font-size: 13px; color: var(--faint); letter-spacing: .04em; }
  .sd-back:hover { color: var(--ink); }

  .sd { max-width: 1200px; margin: 0 auto; padding: 0 40px 40px; }

  /* eyebrow */
  .sd-eyebrow-wrap { padding: 80px 0 40px; }
  .sd-eyebrow { font-family: "DotGothic16", monospace; font-size: 19px; letter-spacing: .05em; color: var(--ink); }

  /* 畫框（通用） */
  .plate {
    margin: 0; background: var(--paper);
    border: 1px solid var(--line); border-radius: 2px; overflow: hidden;
    box-shadow: 0 16px 40px -22px rgba(0,0,0,.4);
  }
  .plate img { display: block; max-width: 100%; height: auto; }

  /* 卡片牆 */
  .sd-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .sd-cardfig { aspect-ratio: 3/4; }
  .sd-cardfig img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .sd-cardfig:hover img { transform: scale(1.05); }

  /* 標題 + 金句 */
  .sd-lead { padding: 110px 0 80px; max-width: 900px; }
  .sd-title { font-family: "Fraunces", serif; font-weight: 400; font-size: clamp(40px, 7vw, 82px); line-height: 1.05; letter-spacing: -.02em; }
  .sd-quote { font-family: "Fraunces", serif; font-size: clamp(20px, 2.6vw, 30px); line-height: 1.5; color: var(--soft); margin-top: 26px; max-width: 26ch; }

  /* 大圖置中 */
  .sd-herographic { display: flex; justify-content: center; margin: 0 0 110px; }

  /* 交錯雙欄 */
  .sd-rows { display: flex; flex-direction: column; gap: 120px; }
  .sd-row { display: flex; gap: 64px; align-items: center; }
  .sd-row.img-right { flex-direction: row-reverse; }
  .sd-row.textonly { display: block; }
  .sd-media { flex: 1 1 0; display: flex; gap: 20px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
  .sd-cell { flex: 1 1 0; }

  .sd-rowhead { display: flex; align-items: center; gap: 20px; margin-bottom: 22px; }
  .sd-rowlabel { font-family: "Fraunces", serif; font-size: 22px; letter-spacing: -.01em; color: var(--ink); white-space: nowrap; }
  .sd-line { height: 1px; flex: 1; background: var(--line); }
  .sd-body { font-family: "Hanken Grotesk", sans-serif; font-size: 16px; line-height: 1.85; color: var(--soft); }
  .sd-inlinequote { font-family: "Fraunces", serif; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.5; color: var(--ink); }
  .sd-row.textonly .sd-body { max-width: 62ch; font-size: 16.5px; }

  /* 情緒能量表 */
  .sd-charttitle { font-family: "Fraunces", serif; font-weight: 500; font-size: 22px; margin: 0 0 16px; }
  .sd-bands { display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 18px; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .sd-swatches { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .sd-swatches li { display: flex; align-items: center; gap: 12px; font-size: 15px; color: var(--soft); }
  .sd-swatches .sw { width: 18px; height: 18px; flex: none; border-radius: 50%; border: 1px solid var(--line); }

  /* 收尾置中 */
  .sd-final { display: flex; justify-content: center; margin: 130px 0 0; }

  /* next */
  .sd-next { text-align: center; padding: 100px 0 40px; }
  .sd-eyebrow-sm { display: block; margin-bottom: 16px; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .sd-next a { font-family: "Fraunces", serif; font-size: clamp(26px, 4vw, 40px); color: var(--ink); border-bottom: 1.5px solid transparent; }
  .sd-next a:hover { border-color: var(--ink); }

  /* footer */
  .sd-footer { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 40px; border-top: 1px solid var(--line); color: var(--faint); font-size: 13px; }
  .sd-social { display: flex; gap: 18px; }
  .sd-social a { color: var(--soft); }
  .sd-social a:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .sd, .sd-footer, .sd-topbar { padding-left: 20px; padding-right: 20px; }
    .sd-cards { grid-template-columns: repeat(2, 1fr); }
    .sd-row, .sd-row.img-right { flex-direction: column; gap: 28px; }
    .sd-rows { gap: 80px; }
  }
</style>

<script is:inline src="/assets/zoom.js" defer></script>

<EcCursor />

</Base>
