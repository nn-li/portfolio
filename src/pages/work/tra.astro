---
import Base from '../../layouts/Base.astro';
import content from '../../content/work/tra.json';
import site from '../../content/site.json';
import EcSiteNav from '../../components/EcSiteNav.astro';
import EcSiteFooter from '../../components/EcSiteFooter.astro';
import EcCursor from '../../components/EcCursor.astro';
---
<Base title={content.seo.title} description={content.seo.description}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/case.css" /></Fragment>

<EcSiteNav />

<main>
  <!-- 滿版 hero -->
  <div class="cx-herobanner">
    <img src={content.hero.cover.src} alt={content.hero.cover.alt} />
  </div>

  <!-- 標題 -->
  <div class="cx-title">
    <span class="eyebrow">{content.hero.eyebrow}</span>
    <h1 class="display">{content.hero.title}</h1>
    <p class="lead">{content.hero.lead}</p>
  </div>

  <!-- meta -->
  <dl class="cx-metarow">
    {content.hero.meta.map((m) => (
      <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
    ))}
  </dl>

  <!-- 左導覽 + 敘事 -->
  <div class="cx">
    <aside class="cx-nav">
      <ul>
        <li><a href="#s1" class="active">{content.ch01.title}</a></li>
        <li><a href="#s2">{content.ch02.title}</a></li>
        <li><a href="#s3">{content.ch03.title}</a></li>
        <li><a href="#s4">{content.ch04.title}</a></li>
      </ul>
    </aside>

    <div class="cx-main">

      <!-- 01 背景與目標 -->
      <section class="cx-sec" id="s1" data-sec>
        <span class="secnum">01</span>
        <h2 class="lbl">{content.ch01.title}</h2>
        <p class="intro" style="max-width:800px">{content.ch01.intro}</p>
        <div class="sub" style="margin-top:60px">
          <h3>{content.ch01.research.heading}</h3>
          <div class="fig" style="margin-top:20px">
            <div class="metrics four" style="margin:0">
              {content.ch01.research.metrics.map((m) => (
                <div class="metric" style="padding:20px 22px"><div class="big">{m.value}</div><div class="lbl"><Fragment set:html={m.label} /></div></div>
              ))}
            </div>
            <p style="font-size:12.5px;color:var(--ink-faint);margin-top:10px">{content.ch01.research.note}</p>
          </div>
        </div>
        <div class="sub" style="margin-top:60px">
          <h3>{content.ch01.scope.heading}</h3>
          <div class="phases" style="margin-top:20px">
            {content.ch01.scope.cards.map((c) => (
              <div class="ph">
                <span style="display:block;font-size:11.5px;font-weight:600;letter-spacing:.06em;color:var(--clay);margin-bottom:4px">{c.tag}</span>
                <span class="pht">{c.title}</span>
                <span class="phw">{c.text}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 02 挑戰與洞察 -->
      <section class="cx-sec" id="s2" data-sec>
        <span class="secnum">02</span>
        <h2 class="lbl">{content.ch02.title}</h2>
        <p class="intro" style="max-width:800px">{content.ch02.intro}</p>
        <div class="phases">
          {content.ch02.methods.map((m) => (
            <div class="ph"><span class="pht">{m.title}</span><span class="phw">{m.text}</span></div>
          ))}
        </div>

        <div class="sub">
          <h3>{content.ch02.reviews.heading}</h3>
          <p>{content.ch02.reviews.text}</p>
          <ul class="facts">
            {content.ch02.reviews.items.map((item) => (
              <li><b style="color:var(--ink)">{item}</b></li>
            ))}
          </ul>
        </div>

        <div class="sub">
          <h3>{content.ch02.participants.heading}</h3>
          <p>{content.ch02.participants.text}</p>
          <div class="phases p4">
            {content.ch02.participants.cards.map((c) => (
              <div class="ph">
                <span class="pht">{c.name}</span>
                <span style="display:block;font-size:11.5px;font-weight:600;letter-spacing:.06em;color:var(--clay);margin-top:2px">{c.frequency}</span>
                <span class="phw">{c.note}</span>
              </div>
            ))}
          </div>
          <p style="font-size:12.5px;color:var(--ink-faint);margin-top:10px">{content.ch02.participants.note}</p>
        </div>

        <div class="sub">
          <h3>{content.ch02.tasks.heading}</h3>
          <p>{content.ch02.tasks.text}</p>
        </div>

        <div class="sub">
          <h3>{content.ch02.journey.heading}</h3>
          {content.ch02.journey.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          <div class="fig"><img class="raw" src={content.ch02.journey.image.src} alt={content.ch02.journey.image.alt} loading="lazy" /><div class="cap">{content.ch02.journey.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch02.findings.heading}</h3>
          <ul class="facts">
            {content.ch02.findings.items.map((item) => (
              <li><b style="color:var(--clay)">{item.title}</b>｜{item.text}</li>
            ))}
          </ul>
          <!-- <p>綜合桌面研究、訪談內容與原 App 任務流程，將後續設計聚焦於主要任務入口、完整任務流程與狀態回饋三個方向。</p> -->
          <!-- <p>研究結果將問題收斂為入口、流程與狀態三個層次。下一階段將進一步說明這些問題如何形成資訊架構、任務流程與介面狀態的設計決策。</p> -->
        </div>
      </section>

      <!-- 03 設計決策 -->
      <section class="cx-sec" id="s3" data-sec>
        <span class="secnum">03</span>
        <h2 class="lbl">{content.ch03.title}</h2>
        <p class="intro" style="max-width:800px">{content.ch03.intro}</p>
        <div class="sub">
          <h3>{content.ch03.tradeoff.heading}</h3>
          <div class="versus">
            <div class="vopt lose">
              <span class="vtag">{content.ch03.tradeoff.lose.tag}</span>
              <p>{content.ch03.tradeoff.lose.text}</p>
            </div>
            <div class="vs" aria-hidden="true"></div>
            <div class="vopt win">
              <span class="vtag">{content.ch03.tradeoff.win.tag}</span>
              <div class="vt">{content.ch03.tradeoff.win.title}</div>
              <p>{content.ch03.tradeoff.win.text}</p>
            </div>
          </div>
          <p style="margin-top:16px">{content.ch03.tradeoff.note}</p>
        </div>

        <div class="sub">
          <h3>{content.ch03.decisions.heading}</h3>
          <p>{content.ch03.decisions.text}</p>
          <div class="dcards">
            {content.ch03.decisions.cards.map((c) => (
              <div class="dcard">
                <span class="dph">{c.phase}</span>
                <span class="dnum">{c.num}</span>
                <h4>{c.title}</h4>
                <span class="dsrc">{c.problem}</span>
                <div class="dline dwin"><span class="k">設計選擇</span><span>{c.choice}</span></div>
                <div class="dline dlose"><span class="k">取捨</span><span>{c.tradeoff}</span></div>
              </div>
            ))}
          </div>
        </div>

        <div class="sub">
          <h3>{content.ch03.ia.heading}</h3>
          <p>{content.ch03.ia.text}</p>
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;align-items:center">
            {content.ch03.ia.pills.map((pill) => (
              <span style="border:1.5px solid var(--accent);border-radius:100px;padding:5px 16px;font-size:14px">{pill}</span>
            ))}
          </div>
          <p style="font-size:12.5px;color:var(--ink-faint);margin-top:10px">{content.ch03.ia.note}</p>
          <details style="margin-top:16px">
            <summary style="cursor:pointer;font-size:14.5px;color:var(--ink-soft)">{content.ch03.ia.summary}</summary>
            <div class="fig"><img class="raw" src={content.ch03.ia.image.src} alt={content.ch03.ia.image.alt} loading="lazy" /><div class="cap">{content.ch03.ia.caption}</div></div>
          </details>
        </div>

        <div class="sub">
          <h3>{content.ch03.userflow.heading}</h3>
          <p>{content.ch03.userflow.text}</p>
          <div class="fig"><img class="raw" src={content.ch03.userflow.image.src} alt={content.ch03.userflow.image.alt} loading="lazy" /><div class="cap">{content.ch03.userflow.caption}</div></div>
        </div>

        <div class="sub">
          <h3>{content.ch03.wireframe.heading}</h3>
          <p>{content.ch03.wireframe.text}</p>
          <div class="sgbox"><img src={content.ch03.wireframe.image.src} alt={content.ch03.wireframe.image.alt} loading="lazy" /></div>
          <div class="boxhint">{content.ch03.wireframe.hint}</div>
        </div>

        <div class="sub">
          <h3>{content.ch03.testing.heading}</h3>
          <p>{content.ch03.testing.text}</p>
        </div>
      </section>

    </div>
  </div>

  <!-- 04 介面設計（淺色展示區） -->
  <section class="uilight" id="s4" data-sec>
    <div class="uhead">
      <span class="k">04</span>
      <h2>{content.ch04.title}</h2>
      <p>{content.ch04.intro}</p>
    </div>

    <div class="ui-sub">
      <span class="k">{content.ch04.styleguide.tag}</span>
      <h3>{content.ch04.styleguide.title}</h3>
      <p>{content.ch04.styleguide.text}</p>
    </div>
    <div class="wide">
      <div class="sgbox"><img src={content.ch04.styleguide.image.src} alt={content.ch04.styleguide.image.alt} loading="lazy" /></div>
      <div class="boxhint">{content.ch04.styleguide.hint}</div>
    </div>

    {content.ch04.screens.map((s) => (
      <Fragment>
        <div class="ui-sub">
          <span class="k">{s.tag}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
        <div class="wide"><img class="raw" src={s.image.src} alt={s.image.alt} loading="lazy" /></div>
      </Fragment>
    ))}

    <!-- <div class="ui-sub">
      <span class="k">Scope</span>
      <h3>專案範圍</h3>
      <p>本案為自主 redesign，未串接真實票務、付款、會員與列車資料。4 位使用者操作原 App 的相同訂票任務，用來找出流程中的理解斷點；新版 Prototype 則由 2 位經常搭乘台鐵的使用者進行任務操作檢查。小樣本結果不能代表整體使用者，也未驗證票務規則、例外情境與工程可行性。</p>
    </div> -->
  </section>

  <section class="next">
    <div class="wrap">
      <span class="eyebrow">{content.next.eyebrow}</span>
      <a href={content.next.href}>{content.next.label}</a>
    </div>
  </section>
</main>

<EcSiteFooter />

<script is:inline>
  // 左側章節錨點：捲動高亮
  const links = [...document.querySelectorAll('.cx-nav a')];
  const map = {}; links.forEach(a => map[a.getAttribute('href')] = a);
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const a = map['#' + e.target.id];
        if (a) a.classList.add('active');
      }
    });
  }, { rootMargin: '-25% 0px -65% 0px' });
  document.querySelectorAll('[data-sec]').forEach(s => io.observe(s));
</script>

<script is:inline src="/assets/zoom.js" defer></script>

<EcCursor />

</Base>
<style is:global>
  /* 本頁參與者卡：桌面四欄，行動版單欄 */
  .phases.p4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 720px) { .phases.p4 { grid-template-columns: 1fr; } }
</style>
